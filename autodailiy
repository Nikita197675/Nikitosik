local function setStatus(text)
	pcall(function()
		status.Text = tostring(text)
	end)
end

-- Перетаскивание за заголовок.
do
	local dragging = false
	local dragStart, startPos
	track(title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end))
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

local busy = false

track(claimBtn.MouseButton1Click:Connect(function()
	if busy then
		return
	end
	local ok, msg = claimDaily()
	setStatus(msg)
end))

-- Auto Daily: забрать на текущем, затем обойти остальные профили с персонажем.
track(autoBtn.MouseButton1Click:Connect(function()
	if busy then
		return
	end
	busy = true
	autoBtn.Text = "Auto Daily (идёт...)"
	task.spawn(function()
		local ok = pcall(function()
			-- 1) текущий профиль
			local _, cmsg = claimDaily()
			setStatus("текущий: " .. tostring(cmsg))
			task.wait(BETWEEN_SLOTS)

			-- 2) список профилей
			local list, current = getProfiles()
			if list == nil then
				setStatus("нет списка профилей — забрал только текущий")
				return
			end
			setStatus(("профилей с персонажем: %d"):format(#list))
			task.wait(0.5)

			-- 3) обход остальных
			for _, slot in ipairs(list) do
				if not _G.__AUTODAILY_ACTIVE then
					return
				end
				if slot ~= current then
					setStatus(("слот %d: переключаюсь..."):format(slot))
					local oldChar = LocalPlayer.Character
					if selectSlot(slot) then
						if waitForRespawn(oldChar, RESPAWN_TIMEOUT) then
							local _, dmsg = claimDaily()
							setStatus(("слот %d: %s"):format(slot, tostring(dmsg)))
						else
							setStatus(("слот %d: не дождался респавна"):format(slot))
						end
					else
						setStatus(("слот %d: не удалось переключить"):format(slot))
					end
					task.wait(BETWEEN_SLOTS)
				end
			end
			setStatus("готово — остаюсь на последнем профиле")
		end)
		if not ok then
			setStatus("ошибка обхода")
		end
		busy = false
		autoBtn.Text = "Auto Daily (все профили)"
	end)
end))

local function unload()
	_G.__AUTODAILY_ACTIVE = false
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	if gui ~= nil then
		gui:Destroy()
	end
end
track(unloadBtn.MouseButton1Click:Connect(unload))

if findDailyPart() == nil then
	setStatus("парт дейли не найден (ты в лобби?)")
end
