-- autodaily.lua — авто-сбор ежедневных наград по профилям (лобби).
-- Дейли забирается касанием невидимого парта workspace..dailyRewardTouchPart
-- (Anchored, Transparency=1, Touched обрабатывает сервер). Касание симулируем
-- через firetouchinterest (не двигая персонажа); фолбэк — телепорт HRP на парт
-- и обратно. Профили = слоты персонажа (remotes.getCharacterSlots -> payload
-- {slots={ {slot, unlocked, created, selected, ...} }}). Auto Daily: забрать на
-- текущем, затем по каждому unlocked+created слоту -> selectCharacterSlot ->
-- ждать респавн -> забрать; остаёмся на последнем профиле.
-- GUI: своя лёгкая (Claim Daily / Auto Daily / Unload).

if _G.__AUTODAILY_ACTIVE then
	return
end
_G.__AUTODAILY_ACTIVE = true

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

local DAILY_PART_NAME = "dailyRewardTouchPart"
local RESPAWN_TIMEOUT = 15
local RESPAWN_BUFFER = 1.2
local BETWEEN_SLOTS = 1

local conns = {}
local function track(conn)
	table.insert(conns, conn)
	return conn
end

-- Вызов RemoteFunction с таймаутом (getCharacterSlots/selectCharacterSlot могут
-- зависнуть, если у сервера нет обработчика). Возвращает первое значение ответа.
local function invokeWithTimeout(remote, timeout, ...)
	local args = { ... }
	local done, result = false, nil
	task.spawn(function()
		local ok, res = pcall(function()
			return remote:InvokeServer(table.unpack(args))
		end)
		done = true
		if ok then
			result = res
		end
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < timeout do
		task.wait(0.05)
	end
	return result
end

local function getRemote(name)
	local remotes = ReplicatedStorage:FindFirstChild("remotes")
	if remotes == nil then
		return nil
	end
	return remotes:FindFirstChild(name)
end

-- Невидимый парт дейли (ищем по имени в workspace).
local function findDailyPart()
	return workspace:FindFirstChild(DAILY_PART_NAME, true)
end

local function getHRP()
	local character = LocalPlayer.Character
	if character == nil then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

-- Симуляция касания в обоих порядках (какой из парт'ов держит TouchInterest —
-- не важно, лишний вызов безвреден).
local function fireTouch(part, hrp, toggle)
	pcall(function()
		firetouchinterest(part, hrp, toggle)
	end)
	pcall(function()
		firetouchinterest(hrp, part, toggle)
	end)
end

-- Забрать дейли на ТЕКУЩЕМ профиле: коснуться парта. Возвращает (ok, текст).
local function claimDaily()
	local part = findDailyPart()
	if part == nil then
		return false, "парт дейли не найден"
	end
	local hrp = getHRP()
	if hrp == nil then
		return false, "нет персонажа"
	end
	if firetouchinterest ~= nil then
		fireTouch(part, hrp, 0)
		task.wait(0.15)
		fireTouch(part, hrp, 1)
		return true, "касание отправлено"
	end
	-- Фолбэк: телепорт HRP на парт (держим ~0.6с чтобы сервер поймал Touched) и назад.
	local ok = pcall(function()
		local save = hrp.CFrame
		for _ = 1, 6 do
			hrp.CFrame = part.CFrame
			task.wait(0.1)
		end
		task.wait(0.2)
		hrp.CFrame = save
	end)
	if ok then
		return true, "касание (телепорт)"
	end
	return false, "ошибка касания"
end

-- Список слотов с персонажем (unlocked+created) + индекс текущего.
local function getProfiles()
	local r = getRemote("getCharacterSlots")
	if r == nil or not r:IsA("RemoteFunction") then
		return nil, nil
	end
	local payload = invokeWithTimeout(r, 6)
	if type(payload) ~= "table" or type(payload.slots) ~= "table" then
		return nil, nil
	end
	local list = {}
	local current = nil
	for _, s in pairs(payload.slots) do
		if type(s) == "table" and s.slot ~= nil then
			if s.selected then
				current = s.slot
			end
			if s.unlocked and s.created then
				table.insert(list, s.slot)
			end
		end
	end
	table.sort(list)
	return list, current
end

-- Переключиться на слот (полный респавн делает сервер). true при успехе.
local function selectSlot(slot)
	local r = getRemote("selectCharacterSlot")
	if r == nil or not r:IsA("RemoteFunction") then
		return false
	end
	local res = invokeWithTimeout(r, 10, slot)
	return res == true
end

-- Ждём новый персонаж после смены слота (+ буфер на прогруз лобби).
local function waitForRespawn(oldChar, timeout)
	local t0 = os.clock()
	while os.clock() - t0 < timeout do
		task.wait(0.1)
		local c = LocalPlayer.Character
		if c ~= nil and c ~= oldChar then
			local hrp = c:FindFirstChild("HumanoidRootPart")
			local hum = c:FindFirstChildOfClass("Humanoid")
			if hrp ~= nil and hum ~= nil and hum.Health > 0 then
				task.wait(RESPAWN_BUFFER)
				return true
			end
		end
	end
	return false
end

