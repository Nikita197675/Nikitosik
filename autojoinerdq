	local function setStatus(text)
		pcall(function()
			status.Text = tostring(text)
		end)
	end

	-- Текущий ник из поля (обрезанные пробелы).
	local function currentTarget()
		return box.Text:gsub("^%s+", ""):gsub("%s+$", "")
	end

	-- Сохранить ник + состояние авто-джойна в конфиг.
	local function persist()
		saveConfig({ target = currentTarget(), enabled = state.enabled })
	end

	-- Одна попытка джойна к нику из поля (общая для Join Once и цикла).
	local function joinOnce()
		local target = currentTarget()
		if target == "" then
			setStatus("введи ник")
			return
		end
		if inLobbyOrGame(LocalPlayer) then
			setStatus("уже в лобби/пати")
			return
		end
		local via = tryJoin(target)
		if via ~= nil then
			setStatus(("запрос -> %s (%s)"):format(target, via))
		else
			setStatus("не найдено: UI/remote")
		end
	end

	-- Применить сохранённое состояние тумблера к виду кнопки.
	local function refreshToggle()
		if state.enabled then
			toggle.Text = "Auto-Join: ON"
			toggle.BackgroundColor3 = Color3.fromRGB(45, 80, 55)
		else
			toggle.Text = "Auto-Join: OFF"
			toggle.BackgroundColor3 = Color3.fromRGB(70, 55, 55)
		end
	end
	refreshToggle()
	if savedTarget ~= "" then
		setStatus("загружено: " .. savedTarget)
	end

	-- Перетаскивание за заголовок.
	do
		local dragging = false
		local dragStart, startPos
		track(title.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = main.Position
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				main.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
	end

	-- Ник сохраняется, как только поле теряет фокус (ввёл один раз — запомнилось).
	track(box.FocusLost:Connect(function()
		persist()
	end))

	track(toggle.MouseButton1Click:Connect(function()
		state.enabled = not state.enabled
		refreshToggle()
		setStatus(state.enabled and "поиск..." or "остановлено")
		persist()
	end))

	track(joinOnceBtn.MouseButton1Click:Connect(function()
		persist()
		joinOnce()
	end))

	local function unload()
		_G.__AUTOJOINER_ACTIVE = false
		state.enabled = false
		for _, c in ipairs(conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
		if gui ~= nil then
			gui:Destroy()
		end
	end
	track(unloadBtn.MouseButton1Click:Connect(unload))

	-- Основной цикл: раз в RETRY секунд шлём join-request к нику из поля.
	-- Итерация в pcall — ошибка (например капабилити/identity) не убивает цикл.
	task.spawn(function()
		while _G.__AUTOJOINER_ACTIVE do
			task.wait(RETRY)
			if state.enabled then
				pcall(joinOnce)
			end
		end
	end)
end

-- == Ветка НЕ-ЛОББИ: клавиша G -> выход в лобби + авто-выход, если цель не тут ==
-- Авто-лив: берём сохранённый ник (target из конфига). Если игрока с этим ником
-- НЕТ в данже (нет в Players) дольше ABSENCE_LIMIT — автоматически выходим в
-- лобби (teleToLobby). JOIN_GRACE в начале — на прогрузку/подтягивание цели.
local JOIN_GRACE = 15
local ABSENCE_LIMIT = 6

local function runOther()
	local function leaveToLobby()
		local remotes = ReplicatedStorage:FindFirstChild("remotes")
		if remotes == nil then
			return
		end
		local tl = remotes:FindFirstChild("teleToLobby")
		if tl ~= nil and tl:IsA("RemoteEvent") then
			pcall(function()
				tl:FireServer()
			end)
			return
		end
		local lg = remotes:FindFirstChild("leaveGame")
		if lg ~= nil and lg:IsA("RemoteEvent") then
			pcall(function()
				lg:FireServer()
			end)
		end
	end

	track(UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		if gameProcessedEvent then
			return
		end
		if UserInputService:GetFocusedTextBox() ~= nil then
			return
		end
		if input.KeyCode == Enum.KeyCode.G then
			leaveToLobby()
		end
	end))

	-- Авто-выход в лобби, если целевой игрок (ник из конфига) не в данже.
	local saved = loadConfig()
	local target = ""
	if type(saved.target) == "string" then
		target = saved.target:gsub("^%s+", ""):gsub("%s+$", "")
	end
	if target ~= "" then
		task.spawn(function()
			local startAt = os.clock()
			local absentSince = nil
			local left = false
			while _G.__AUTOJOINER_ACTIVE and not left do
				task.wait(2)
				if os.clock() - startAt >= JOIN_GRACE then
					local present = Players:FindFirstChild(target) ~= nil
					if present then
						absentSince = nil
					else
						if absentSince == nil then
							absentSince = os.clock()
						elseif os.clock() - absentSince > ABSENCE_LIMIT then
							left = true
							leaveToLobby()
						end
					end
				end
			end
		end)
	end

	-- Короткий тост-хинт.
	local gui = Instance.new("ScreenGui")
	gui.Name = "AutoJoinerHint"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 200
	gui.Parent = guiParent()
	local hint = Instance.new("TextLabel")
	hint.Size = UDim2.fromOffset(240, 26)
	hint.Position = UDim2.new(0.5, -120, 0, 8)
	hint.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	hint.BackgroundTransparency = 0.25
	hint.BorderSizePixel = 0
	hint.Text = (target ~= "" and ("G — выход | авто-лив если нет: " .. target))
		or "G — выход в лобби"
	hint.TextColor3 = Color3.fromRGB(220, 220, 220)
	hint.Font = Enum.Font.Gotham
	hint.TextSize = 13
	hint.TextTruncate = Enum.TextTruncate.AtEnd
	hint.Parent = gui
	local hintCorner = Instance.new("UICorner")
	hintCorner.CornerRadius = UDim.new(0, 6)
	hintCorner.Parent = hint
	task.delay(5, function()
		if gui ~= nil then
			gui:Destroy()
		end
	end)
end

if game.PlaceId == LOBBY_PLACE_ID then
	runLobby()
else
	runOther()
end
