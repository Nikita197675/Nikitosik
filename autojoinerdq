	status.Parent = main

	local unloadBtn = Instance.new("TextButton")
	unloadBtn.Size = UDim2.new(1, -20, 0, 26)
	unloadBtn.Position = UDim2.fromOffset(10, 178)
	unloadBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	unloadBtn.BorderSizePixel = 0
	unloadBtn.Text = "Unload"
	unloadBtn.TextColor3 = Color3.fromRGB(220, 180, 180)
