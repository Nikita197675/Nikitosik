		if via ~= nil then
			setStatus(("запрос -> %s (%s)"):format(target, via))
		else
			setStatus("не найдено: UI/remote")
		end
	end

	-- Применить сохранённое состояние тумблера к виду кнопки.
	local function refreshToggle()
		if state.enabled then
			toggle.Text = "Auto-Join: ON"
			toggle.BackgroundColor3 = Color3.fromRGB(45, 80, 55)
		else
			toggle.Text = "Auto-Join: OFF"
			toggle.BackgroundColor3 = Color3.fromRGB(70, 55, 55)
		end
	end
	refreshToggle()
	if savedTarget ~= "" then
		setStatus("загружено: " .. savedTarget)
	end

	-- Перетаскивание за заголовок.
	do
		local dragging = false
		local dragStart, startPos
		track(title.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = main.Position
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				main.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
	end

	-- Ник сохраняется, как только поле теряет фокус (ввёл один раз — запомнилось).
	track(box.FocusLost:Connect(function()
		persist()
	end))

	track(toggle.MouseButton1Click:Connect(function()
		state.enabled = not state.enabled
		refreshToggle()
		setStatus(state.enabled and "поиск..." or "остановлено")
		persist()
	end))

	track(joinOnceBtn.MouseButton1Click:Connect(function()
		persist()
		joinOnce()
	end))

	local function unload()
		_G.__AUTOJOINER_ACTIVE = false
		state.enabled = false
		for _, c in ipairs(conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
		if gui ~= nil then
			gui:Destroy()
		end
	end
	track(unloadBtn.MouseButton1Click:Connect(unload))

	-- Основной цикл: раз в RETRY секунд шлём join-request к нику из поля.
	-- Итерация в pcall — ошибка (например капабилити/identity) не убивает цикл.
	task.spawn(function()
		while _G.__AUTOJOINER_ACTIVE do
			task.wait(RETRY)
			if state.enabled then
				pcall(joinOnce)
			end
		end
	end)
end

-- == Ветка НЕ-ЛОББИ: клавиша G -> выход в лобби + авто-выход, если цель ушла ==
-- Авто-лив (edge-детект): лив ТОЛЬКО после того, как лидера (target из конфига)
-- хоть раз увидели в данже и он пропал дольше ABSENCE_LIMIT (лидер реально ушёл).
-- Если лидер так и не появился за NEVER_SEEN_LIMIT — лив (не тот инстанс).
-- Сравнение ника — без учёта регистра. JOIN_GRACE больше не нужен (edge-детект).
local ABSENCE_LIMIT = 10
local NEVER_SEEN_LIMIT = 60

local function runOther()
	local function leaveToLobby()
		local remotes = ReplicatedStorage:FindFirstChild("remotes")
		if remotes == nil then
			return
		end
		local tl = remotes:FindFirstChild("teleToLobby")
		if tl ~= nil and tl:IsA("RemoteEvent") then
			pcall(function()
				tl:FireServer()
			end)
			return
		end
		local lg = remotes:FindFirstChild("leaveGame")
		if lg ~= nil and lg:IsA("RemoteEvent") then
			pcall(function()
				lg:FireServer()
			end)
		end
	end

	track(UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		if gameProcessedEvent then
			return
		end
		if UserInputService:GetFocusedTextBox() ~= nil then
			return
		end
		if input.KeyCode == Enum.KeyCode.G then
			leaveToLobby()
		end
	end))

	-- Статус-панель (видно, что происходит с авто-ливом).
	local gui = Instance.new("ScreenGui")
	gui.Name = "AutoJoinerHint"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 200
	gui.Parent = guiParent()
	local hint = Instance.new("TextLabel")
	hint.Size = UDim2.fromOffset(300, 26)
	hint.Position = UDim2.new(0.5, -150, 0, 8)
	hint.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
	hint.BackgroundTransparency = 0.25
	hint.BorderSizePixel = 0
	hint.Text = "G — выход в лобби"
	hint.TextColor3 = Color3.fromRGB(220, 220, 220)
	hint.Font = Enum.Font.Gotham
	hint.TextSize = 13
	hint.TextTruncate = Enum.TextTruncate.AtEnd
	hint.Parent = gui
	local hintCorner = Instance.new("UICorner")
	hintCorner.CornerRadius = UDim.new(0, 6)
	hintCorner.Parent = hint
	track(hint.AncestryChanged:Connect(function() end))

	-- Авто-выход в лобби, если целевой игрок (ник из конфига) ПОКИНУЛ данж.
	-- Edge-детект: лив разрешён ТОЛЬКО после того, как цель хоть раз увидели в
	-- данже (лидер был тут и ушёл). Если цель так и не появилась за
	-- NEVER_SEEN_LIMIT — лив (попали не в тот инстанс). Сравнение ника — без
	-- учёта регистра (playerPresentByName).
	local saved = loadConfig()
	local target = ""
	if type(saved.target) == "string" then
		target = saved.target:gsub("^%s+", ""):gsub("%s+$", "")
	end
	if target ~= "" then
		task.spawn(function()
			local startAt = os.clock()
			local absentSince = nil
			local seenTarget = false
			local left = false
			while _G.__AUTOJOINER_ACTIVE and not left do
				task.wait(1)
				local present = playerPresentByName(target)
				local now = os.clock()
				if present then
					seenTarget = true
					absentSince = nil
				elseif absentSince == nil then
					absentSince = now
				end

				if present then
					hint.Text = ("%s в данже"):format(target)
					hint.TextColor3 = Color3.fromRGB(150, 220, 150)
				elseif seenTarget then
					local gone = now - absentSince
					hint.Text = ("%s ушёл %.0fs (лив через %.0fs)"):format(
						target, gone, math.max(ABSENCE_LIMIT - gone, 0))
					hint.TextColor3 = Color3.fromRGB(255, 200, 120)
					if gone > ABSENCE_LIMIT then
						left = true
						leaveToLobby()
					end
				else
					local waited = now - startAt
					hint.Text = ("жду %s %.0fs"):format(target, waited)
					hint.TextColor3 = Color3.fromRGB(200, 200, 210)
					-- Ни разу не увидели лидера -> вероятно не тот инстанс.
					if waited > NEVER_SEEN_LIMIT then
						left = true
						leaveToLobby()
					end
				end
			end
		end)
	else
		task.delay(5, function()
			if gui ~= nil then
				gui:Destroy()
			end
		end)
	end
end

-- == Ветка ДАНЖА (PlaceId 85776757589518): постоянно жмём Ready ==
-- Кнопка readyButton появляется в PlayerGui когда dungeonProgress ==
-- "playersNotReady". Путь: readyButton.Frame["3d"].Frame.TextButton.
-- Обработчик: TextButton.Activated -> remotes.readyUp:FireServer().
-- Жмём постоянно в цикле, пока кнопка не исчезнет (не нажмёт).
local function runDungeonReady()
	local function pressReadyButton()
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if playerGui == nil then
			return false
		end
		local readyButton = playerGui:FindFirstChild("readyButton")
		if readyButton == nil then
			return false
		end
		local frame = readyButton:FindFirstChild("Frame")
		if frame == nil then
			return false
		end
		local threeD = frame:FindFirstChild("3d")
		if threeD == nil then
			return false
		end
		local innerFrame = threeD:FindFirstChild("Frame")
		if innerFrame == nil then
			return false
		end
		local textButton = innerFrame:FindFirstChild("TextButton")
		if textButton == nil then
			return false
		end
		-- Прямой вызов Activated (как в игре).
		if getconnections ~= nil then
			local ok, conns = pcall(getconnections, textButton.Activated)
			if ok and type(conns) == "table" then
				for _, conn in ipairs(conns) do
					pcall(function()
						conn:Fire()
					end)
				end
				return true
			end
		end
		if firesignal ~= nil then
			pcall(function()
				firesignal(textButton.Activated)
			end)
			return true
		end
		return false
	end

	-- Цикл: раз в 0.5с проверяем и жмём Ready, пока кнопка видна.
	task.spawn(function()
		while _G.__AUTOJOINER_ACTIVE do
			task.wait(0.5)
			pcall(pressReadyButton)
		end
	end)
end

if game.PlaceId == LOBBY_PLACE_ID then
	runLobby()
elseif game.PlaceId == DUNGEON_PLACE_ID then
	runDungeonReady()
else
	runOther()
end
