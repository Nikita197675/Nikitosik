-- autojoiner.lua — авто-джойнер к игроку по нику (лобби) + выход в лобби по G.
-- Лобби (PlaceId 77649408247578): своя лёгкая GUI — поле ввода ника, тумблер
-- Auto-Join, статус, Unload. Раз в 2с (пока не в лобби/пати) отправляет
-- join-request к указанному нику: выставляет ник в родное поле
-- queueGui.gameSearch.joinRequest.usernameField.usernameBox и «нажимает»
-- кнопку sendRequest.TextButton (getconnections/firesignal) — родной
-- контроллер игры сам зовёт remotes.sendJoinRequest:InvokeServer(ник, false).
-- Фолбэк (нет firesignal/getconnections или кнопки): прямой InvokeServer.
-- Не-лобби (данж и пр.): клавиша G -> выход в лобби через remotes.teleToLobby
-- (фолбэк leaveGame), оба FireServer без аргументов. Плюс АВТО-ЛИВ: если
-- целевого игрока (ник из конфига) НЕТ в данже дольше ABSENCE_LIMIT (после
-- стартового JOIN_GRACE на прогрузку) — автоматически выходим в лобби.
-- Авто-лоад после телепорта: queue_on_teleport тянет скрипт по REMOTE_URL,
-- один и тот же скрипт ветвится по PlaceId.

if _G.__AUTOJOINER_ACTIVE then
	return
end
_G.__AUTOJOINER_ACTIVE = true

-- Авто-лоад после телепорта: скрипт тянется по REMOTE_URL (публичный raw).
local REMOTE_URL = "https://raw.githubusercontent.com/Nikita197675/Nikitosik/refs/heads/main/autojoinerdq"

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

local LOBBY_PLACE_ID = 77649408247578
local RETRY = 2

-- == Авто-лоад после телепорта (queue_on_teleport) ==
local function queueTeleport(str)
	local fn = queue_on_teleport or queueonteleport
		or (getgenv and (getgenv().queue_on_teleport or getgenv().queueonteleport))
	if fn == nil then
		return false
	end
	local ok = pcall(fn, str)
	return ok
end

if REMOTE_URL ~= "" then
	local loader = ([[
		repeat task.wait(0.1) until game:IsLoaded()
		local Players = game:GetService("Players")
		while Players.LocalPlayer == nil do
			task.wait(0.1)
		end
		task.wait(2)
		for _ = 1, 10 do
			local ok = pcall(function()
				loadstring(game:HttpGet(%q))()
			end)
			if ok then
				return
			end
			task.wait(1)
		end
	]]):format(REMOTE_URL)
	queueTeleport(loader)
end

-- == Общие хелперы ==

-- Родитель для GUI: PlayerGui. НЕ используем gethui()/CoreGui — это
-- защищённые контейнеры (нужна capability Plugin), и после «нажатия» родной
-- кнопки через getconnections identity потока падает, из-за чего доступ к
-- таким Instance'ам роняет цикл. PlayerGui доступен при любой identity.
local function guiParent()
	return LocalPlayer:WaitForChild("PlayerGui")
end

local conns = {}
local function track(conn)
	table.insert(conns, conn)
	return conn
end

-- == Сохранение настроек (ник + состояние авто-джойна) ==
-- Файл AutoJoiner/config.json в папке executor'а: ник и вкл/выкл авто-джойна
-- переживают перезапуск/телепорт и подгружаются сами при старте.
local CONFIG_PATH = "AutoJoiner/config.json"

local function saveConfig(data)
	if writefile == nil then
		return
	end
	pcall(function()
		if makefolder ~= nil then
			makefolder("AutoJoiner")
		end
	end)
	pcall(function()
		writefile(CONFIG_PATH, HttpService:JSONEncode(data))
	end)
end

local function loadConfig()
	if isfile == nil or readfile == nil then
		return {}
	end
	local exists = false
	pcall(function()
		exists = isfile(CONFIG_PATH)
	end)
	if not exists then
		return {}
	end
	local ok, result = pcall(function()
		return HttpService:JSONDecode(readfile(CONFIG_PATH))
	end)
	if ok and type(result) == "table" then
		return result
	end
	return {}
end

-- Прямой вызов ремоута (фолбэк, если кнопку/сигнал нажать нельзя).
local function sendJoinDirect(name)
	local remotes = ReplicatedStorage:FindFirstChild("remotes")
	local r = remotes ~= nil and remotes:FindFirstChild("sendJoinRequest") or nil
	if r ~= nil and r:IsA("RemoteFunction") then
		task.spawn(function()
			pcall(function()
				r:InvokeServer(name, false)
			end)
		end)
		return "remote"
	end
	return nil
end

-- «Нажать» кнопку игры: воспроизводим её подключённые обработчики.
local function fireButton(button)
	local sig = button.MouseButton1Click
	if getconnections ~= nil then
		local ok, list = pcall(getconnections, sig)
		if ok and list ~= nil then
			local fired = false
			for _, c in ipairs(list) do
				pcall(function()
					c:Fire()
				end)
				fired = true
			end
			if fired then
				return true
			end
		end
	end
	if firesignal ~= nil then
		local ok = pcall(firesignal, sig)
		if ok then
			return true
		end
	end
	return false
end

-- Уже в собранном лобби/данже? (логика из клиента игры: workspace.games)
local function inLobbyOrGame(player)
	local games = workspace:FindFirstChild("games")
	if games == nil then
		return false
	end
	for _, folderName in ipairs({ "inGame", "inLobby" }) do
		local folder = games:FindFirstChild(folderName)
		if folder ~= nil then
			for _, child in ipairs(folder:GetChildren()) do
				if child:FindFirstChild(player.Name) ~= nil then
					return true
				end
			end
		end
	end
	return false
end

-- Путь к родному полю ввода / кнопке join-request (nil-safe).
local function findJoinRequestUI()
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui == nil then
		return nil, nil
	end
	local queueGui = playerGui:FindFirstChild("queueGui")
	if queueGui == nil then
		return nil, nil
	end
	local gameSearch = queueGui:FindFirstChild("gameSearch")
	if gameSearch == nil then
		return nil, nil
	end
	local joinRequest = gameSearch:FindFirstChild("joinRequest")
	if joinRequest == nil then
		return nil, nil
	end
	local usernameField = joinRequest:FindFirstChild("usernameField")
	local box = usernameField ~= nil and usernameField:FindFirstChild("usernameBox") or nil
	local sendRequest = joinRequest:FindFirstChild("sendRequest")
	local btn = sendRequest ~= nil and sendRequest:FindFirstChild("TextButton") or nil
	return box, btn
end

-- Одна попытка присоединения по нику. Возвращает способ ("button"/"remote") или nil.
-- Нажатие кнопки делаем в ОТДЕЛЬНОМ потоке: getconnections():Fire() роняет
-- identity текущего потока (родная кнопка = game-скрипт без capability),
-- и это не должно утекать в цикл, который потом трогает наш GUI.
local function tryJoin(name)
	local box, btn = findJoinRequestUI()
	if box ~= nil and btn ~= nil and (getconnections ~= nil or firesignal ~= nil) then
		box.Text = name
		task.spawn(function()
			pcall(fireButton, btn)
		end)
		return "button"
	end
	return sendJoinDirect(name)
end

-- == Ветка ЛОББИ: GUI + авто-джойн ==
local function runLobby()
