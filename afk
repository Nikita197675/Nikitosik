-- AFK Q/E Auto Press + AntiAFK (эксплоит) | работает даже когда окно не в фокусе
-- Логика AntiAFK твоя, пофикшена (Instance.new -> GetService)

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local speaker = LocalPlayer

-- // 1. ANTI-AFK ВСЕГДА ВКЛ (твоя логика)
local antiAfkCon = nil
do
    if getconnections then
        pcall(function()
            for _, c in getconnections(speaker.Idled) do
                pcall(function() c:Disable() end)
                pcall(function() c:Disconnect() end)
            end
        end)
    end
    pcall(function() if antiAfkCon then antiAfkCon:Disconnect() end end)

    -- правильный способ получить VirtualInputManager (не Instance.new)
    local vimOk, vim = pcall(function()
        local s = game:GetService("VirtualInputManager")
        return (cloneref and cloneref(s) or s)
    end)

    antiAfkCon = speaker.Idled:Connect(function()
        -- основной метод - через VirtualInputManager (работает в фоне, без фокуса)
        if vimOk and vim then
            pcall(function()
                vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
        -- фолбэк для эксплоитов без VIM
        pcall(function()
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:ClickButton1(Vector2.new())
        end)
    end)
end

-- // 2. АВТО-НАЖАТИЕ Q/E по очереди каждые 2 сек (работает в фоне)
local Enabled = false
local Interval = 2
local Keys = {Enum.KeyCode.Q, Enum.KeyCode.E}
local idx = 1
local loopThread = nil

local function getVIM()
    local ok, vim = pcall(function()
        local s = game:GetService("VirtualInputManager")
        return (cloneref and cloneref(s) or s)
    end)
    if ok and vim and vim.SendKeyEvent then return vim end
    return nil
end

local function sendKey(keyCode)
    -- 1 приоритет: VirtualInputManager:SendKeyEvent - работает даже если окно не в фокусе (виртуальный инпут)
    local vim = getVIM()
    if vim then
        pcall(function()
            vim:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, keyCode, false, game)
        end)
        return
    end
    -- 2 фолбэк: keypress/keyrelease (старые эксплоиты, тоже в фоне)
    if keypress and keyrelease then
        local code = (keyCode == Enum.KeyCode.Q) and 0x51 or 0x45
        pcall(function()
            keypress(code)
            task.wait(0.05)
            keyrelease(code)
        end)
        return
    end
    -- 3 фолбэк: VirtualUser
    pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:CaptureController()
    end)
end

local function startLoop()
    if loopThread then return end
    loopThread = task.spawn(function()
        while Enabled do
            sendKey(Keys[idx])
            idx = (idx == 1) and 2 or 1
            task.wait(Interval)
        end
        loopThread = nil
    end)
end

local function stopLoop()
    Enabled = false
    -- поток сам выйдет на следующем wait, не надо убивать
end

