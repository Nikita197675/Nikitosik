info.Size = UDim2.fromOffset(190, 12)
info.Position = UDim2.fromOffset(10, 97)
info.BackgroundTransparency = 1
info.Text = "Q → E каждые 2 сек • работает без фокуса"
info.TextColor3 = Color3.fromRGB(110,110,110)
info.Font = Enum.Font.Gotham
info.TextSize = 10

close.MouseButton1Click:Connect(function()
    gui:Destroy()
    stopLoop()
end)

toggle.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    if Enabled then
        toggle.Text = "ВКЛ  •  Нажми чтобы выкл"
        toggle.BackgroundColor3 = Color3.fromRGB(40, 165, 75)
        status.Text = "Жмёт: Q → E каждые 2с..."
        startLoop()
    else
        toggle.Text = "ВЫКЛ  •  Нажми чтобы вкл"
        toggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
        status.Text = "Пауза • Анти-АФК: ✅ всегда вкл"
        stopLoop()
    end
end)

-- перетаскивание
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
