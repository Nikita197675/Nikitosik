-- == Сохранение конфига (файл DungeonBot/config.json в папке executor'а) ==

-- Конфиг — ПЕРСОНАЛЬНЫЙ на аккаунт (DungeonBot/config_<ник>.json): два
-- игрока на одном executor'е не перезаписывают роли/настройки друг друга.
local function configFilePath()
	local name = "default"
	local lp = Players.LocalPlayer
	if lp ~= nil and type(lp.Name) == "string" then
		name = lp.Name
	end
	return "DungeonBot/config_" .. name .. ".json"
end
local CONFIG_VERSION = 2

local function saveConfig()
	if writefile == nil then
		log("config save: writefile unavailable in this executor")
		return false
	end
	pcall(function()
		makefolder("DungeonBot")
	end)
	local data = {}
	for key, value in pairs(cfg) do
		-- Строки ОБЯЗАТЕЛЬНО: duoRole ("p1"/"p2"), skill-слоты и т.д.
		if type(value) == "boolean" or type(value) == "number" or type(value) == "string" then
			data[key] = value
		end
	end
	data.configVersion = CONFIG_VERSION
	if bot.currentDungeon ~= nil then
		data.dungeon = bot.currentDungeon
	end
	local ok = pcall(function()
		local path = configFilePath()
		writefile(path, game:GetService("HttpService"):JSONEncode(data))
		log("config saved: " .. path)
	end)
	if not ok then
		log("config save: failed")
	end
	return ok
end

local saveQueued = false
local function scheduleSave()
	if not cfg.autoSave then
		return
	end
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(1, function()
		saveQueued = false
		saveConfig()
	end)
end

local function applyConfigData(data)
	if type(data) ~= "table" then
		return 0
	end
	local applied = 0
	local oldConfig = data.configVersion ~= CONFIG_VERSION
	for key, value in pairs(data) do
		if key ~= "dungeon" and key ~= "configVersion" and cfg[key] ~= nil and type(cfg[key]) == type(value) then
			-- Старый конфиг (без версии): castRange не восстанавливаем — пусть
			-- применится новый дефолт (90); остальное восстанавливаем как есть.
			if not (oldConfig and key == "castRange") then
				cfg[key] = value
				applied += 1
			end
		end
	end
	local dungeon = data.dungeon
	if type(dungeon) == "string" and DUNGEONS[dungeon] ~= nil then
		bot.currentDungeon = dungeon
		resetRoute()
		applied += 1
		log("config: dungeon -> " .. dungeon)
	end
	-- Duo-роль: валидация сохранённого значения (строка из config.json).
	if cfg.duoRole ~= "p1" and cfg.duoRole ~= "p2" then
		cfg.duoRole = "off"
	else
		log("config: duoRole -> " .. cfg.duoRole)
	end
	-- Способности в слотах: валидация сохранённых значений по списку.
	-- "none" = слот выключен; неизвестное имя -> дефолт.
	if not isValidSkillName(cfg.skillSlot1) then
		cfg.skillSlot1 = "Geyser"
	else
		log("config: skillSlot1 -> " .. cfg.skillSlot1)
	end
	if not isValidSkillName(cfg.skillSlot2) then
		cfg.skillSlot2 = "Chain Lightning"
	else
		log("config: skillSlot2 -> " .. cfg.skillSlot2)
	end
	-- Порог переноса в сторейдж: диапазон 10–300.
	if type(cfg.transferThreshold) ~= "number"
		or cfg.transferThreshold < 10 or cfg.transferThreshold > 300 then
		cfg.transferThreshold = 280
	end
	-- Режим бега: валидация сохранённого значения по реестру RUN_MODES.
	if not isValidRunMode(cfg.runMode) then
		cfg.runMode = "Выкл"
	else
		log("config: runMode -> " .. cfg.runMode)
	end
	-- Таймаут ожидания игроков: диапазон 10–180с.
	if type(cfg.waitPlayersTimeout) ~= "number"
		or cfg.waitPlayersTimeout < 10 or cfg.waitPlayersTimeout > 180 then
		cfg.waitPlayersTimeout = 60
	end
	return applied
end

local function loadConfig()
	if isfile == nil or readfile == nil then
		log("config load: file api unavailable")
		return false
	end
	local ok, result = pcall(function()
		return game:GetService("HttpService"):JSONDecode(readfile(configFilePath()))
	end)
	if not ok or type(result) ~= "table" then
		return false
	end
	local applied = applyConfigData(result)
	log(("config loaded: %d settings applied"):format(applied))
	return true
end

