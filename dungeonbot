		part.Parent = workspace
		table.insert(spawnMarkers, part)
	end
	log(("spawn markers: %d"):format(#spawnMarkers))
end

-- Подсветка цели: жёлтый маркер на том, кого бот атакует (castTarget/target).
local function applyHighlight()
	if highlight == nil then
		return
	end
	local focus = nil
	if bot.castTarget ~= nil and bot.castTarget.Parent ~= nil then
		focus = bot.castTarget
	elseif bot.target ~= nil and bot.target.Parent ~= nil then
		focus = bot.target
	end
	if cfg.highlight and cfg.enabled and focus then
		highlight.Adornee = nil
		highlight.Parent = focus
	else
		highlight.Parent = nil
	end
end

local function stopMovement()
	local hrp, humanoid = getCharParts()
	if hrp ~= nil and humanoid ~= nil then
		humanoid:MoveTo(hrp.Position)
	end
end

local function setEnabled(value)
	cfg.enabled = value
	if value then
		log("bot ON")
		resetPathState()
		bot.target = nil
	else
		log("bot OFF")
		stopMovement()
		bot.target = nil
		bot.waitUntil = nil
	end
	applyHighlight()
end

local function setTarget(model, reason)
	if bot.target == model then
		return
	end
	bot.target = model
	resetPathState()
	applyHighlight()
	if model ~= nil then
		log(("target: %s (%s)"):format(model.Name, reason or "?"))
	else
		log("target: none (" .. tostring(reason) .. ")")
	end
end

-- Ретаргет каждые cfg.retargetInterval: меняем цель, только если новый моб
-- ближе текущего более чем на HYSTERESIS (20%) — без пинг-понга между мобами
-- на равной дистанции. Моб за барьером (LOS заблокирован) = +30 studs штрафа.
local function retargetTick()
	if not cfg.enabled or bot.target == nil then
		return
	end
	local hrp = bot.hrp
	if hrp == nil then
		return
	end
	local model = bot.target
	if not model:IsDescendantOf(workspace) then
		setTarget(nil, "gone")
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		setTarget(nil, "died")
		return
	end
	local current = targetScore(model, hrp)
	if current == nil then
		setTarget(nil, "no-root")
		return
	end
	local best, bestScore = pickTarget()
	if best ~= nil and best ~= model and bestScore < current * (1 - HYSTERESIS) then
		setTarget(best, "closer")
	end
end

task.spawn(function()
	while not unloaded do
		task.wait(math.max(cfg.retargetInterval * rand(0.85, 1.15), 0.1))
		retargetTick()
	end
end)

-- == Скиллы: нажатие слота q/e КАК РЕАЛЬНЫЙ ИГРОК ==
-- Из декомпила обработчика нажатий (StarterGui.UIS): клавиша Q/E ->
--   tool.localEvent:Fire()            -- локальная анимация/эффекты (видно!)
--   remotes.abilityUsed:FireServer(slot, tool)   -- серверу: нажат слот
-- Повторяем этот путь (вариант B): анимация проигрывается, сервер получает
-- тот же remote — не отличить от реального игрока. abilityEvent БОЛЬШЕ НЕ ЖМЁМ.
-- Готовность — из сигналов игры: tool.cooldown <= 0 и не busyCasting.

local CAST_DEBOUNCE = 0.5

-- Стейт по слоту ("q"/"e"): анти-спам дебаунс.
local skillState = {}

-- NumberValue-потомок Tool'а (cooldown / cooldownLength). nil-safe.
local function toolNumber(tool, name)
	local v = tool:FindFirstChild(name)
	if v ~= nil and v:IsA("NumberValue") then
		return v.Value
	end
	return nil
end

-- busyCasting на персонаже (BoolValue из дампов). nil-safe.
local function isBusyCasting()
	local character = LocalPlayer.Character
	if character == nil then
		return false
	end
	local bc = character:FindFirstChild("busyCasting")
	if bc ~= nil and bc:IsA("BoolValue") then
		return bc.Value
	end
	return false
end

-- Ремоут abilityUsed (как в игровом обработчике нажатий).
local function getAbilityUsedRemote()
	local remotes = ReplicatedStorage:FindFirstChild("remotes")
	if remotes == nil then
		return nil
	end
	local r = remotes:FindFirstChild("abilityUsed")
	if r ~= nil and r:IsA("RemoteEvent") then
		return r
	end
	return nil
end

-- Tool слота ("q"/"e") в Backpack/Character по abilitySlot.Value.
local function findSlotTool(slot)
	local character = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	for _, container in ipairs({ backpack, character }) do
		if container ~= nil then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					local s = tool:FindFirstChild("abilitySlot")
					if s ~= nil and s:IsA("StringValue") and s.Value == slot then
						return tool
					end
				end
			end
		end
	end
	return nil
end

-- Нажатие слота как реальный игрок: localEvent:Fire() (анимация) +
-- abilityUsed:FireServer(slot, tool). Возвращает true, если дёрнули remote.
local function pressAbility(slot, tool)
	tool = tool or findSlotTool(slot)
	if tool == nil then
		return false
	end
	local le = tool:FindFirstChild("localEvent")
	if le ~= nil and le:IsA("BindableEvent") then
		pcall(function()
			le:Fire()
		end)
	end
	local au = getAbilityUsedRemote()
	if au == nil then
		return false
	end
	local ok = pcall(function()
		au:FireServer(slot, tool)
	end)
	return ok
end

-- Боевой каст: жмём слоты q/e (как игрок), если их Tool выбран в skillSlot1/2
-- по имени и готов (cooldown <= 0, не busyCasting). Слот активного режима бега
-- пропускаем — им управляет режим бега. waitOnSkills -> стойка на cooldownLength.
local function fireSkills(now, targetName)
	local wanted = {}
	if cfg.skillSlot1 ~= nil and cfg.skillSlot1 ~= "none" then
		wanted[cfg.skillSlot1] = true
	end
	if cfg.skillSlot2 ~= nil and cfg.skillSlot2 ~= "none" then
		wanted[cfg.skillSlot2] = true
	end
	if next(wanted) == nil then
		return
	end
	local runTool = nil
	local mode = runModeByName(cfg.runMode)
	if mode ~= nil then
		runTool = mode.toolName
	end
	local fired = false
	local maxReady = 0
	for _, slot in ipairs({ "q", "e" }) do
		local tool = findSlotTool(slot)
		if tool ~= nil and wanted[tool.Name] and (runTool == nil or tool.Name ~= runTool) then
			local st = skillState[slot]
			if st == nil then
				st = { debouncedUntil = 0 }
				skillState[slot] = st
			end
			-- Нативный гейт игры + дебаунс (окно репликации cooldown > 0 при пинге).
			local canFire = (toolNumber(tool, "cooldown") or 0) <= 0
				and not isBusyCasting()
				and now >= st.debouncedUntil
			if canFire then
				if pressAbility(slot, tool) then
					fired = true
					st.debouncedUntil = now + CAST_DEBOUNCE
					local cdLen = toolNumber(tool, "cooldownLength")
					if cdLen ~= nil then
						maxReady = math.max(maxReady, now + cdLen)
					end
					log(("skill: %s (slot %s) -> %s"):format(
						tool.Name, slot, targetName or (bot.target and bot.target.Name) or "?"))
				end
			end
		end
	end
	-- Стойка: ровно cooldownLength от момента каста (без таймеров кд).
	if fired and cfg.waitOnSkills and maxReady > now
		and (bot.waitUntil == nil or now >= bot.waitUntil) then
		bot.waitUntil = maxReady
		log(("wait: skills fired, standing %.1fs"):format(maxReady - now))
	end
end

-- == Ranged-каст (castRange studs, без LOS) + аимлок ==

-- Радиус каста: обычный — castRange (90); на босс-гейте — bossGateCast
-- (отдельный ползунок), чтобы не дергать босса раньше подхода к гейт-точке.
local function effectiveCastRange()
	local wps = getRoute(bot.currentDungeon)
	if wps ~= nil and bot.routeIndex <= #wps then
		local _, isBoss = wpInfo(wps[bot.routeIndex])
		if isBoss then
			return cfg.bossGateCast
		end
	end
	return cfg.castRange
end

local function findCastTarget(hrp)
	local castRange = effectiveCastRange()
	if castRange <= 0 then
		return nil
	end
	local best, bestDist = nil, math.huge
	for model in pairs(bot.enemies) do
		local root = getRoot(model)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if root ~= nil and humanoid ~= nil and humanoid.Health > 0 then
			local d = (root.Position - hrp.Position).Magnitude
			if d < bestDist then
				best, bestDist = model, d
			end
		end
	end
	if best == nil or bestDist > castRange then
		return nil
	end
	return best
end

local function castTargetRoot()
	local model = bot.castTarget
	if model == nil or not model:IsDescendantOf(workspace) then
		return nil
	end
	local root = getRoot(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if root == nil or humanoid == nil or humanoid.Health <= 0 then
		return nil
	end
	return root
end

-- Аимлок ТОЛЬКО ТЕЛОМ (камеру не трогаем — игра без шифтлока): персонаж
-- доворачивается к цели каста через faceTarget с временным AutoRotate=false.
-- Камера полностью под управлением игрока/игры.

local function computePathAsync(hrp, goalPos)
	bot.pathComputing = true
	bot.pathComputeStart = os.clock()
	local startPos = hrp.Position
	task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
		})
		local ok = pcall(function()
			path:ComputeAsync(startPos, goalPos)
		end)
		bot.pathComputing = false
		if not ok or path.Status ~= Enum.PathStatus.Success then
			bot.pathMode = "direct"
			bot.lastRepath = os.clock()
			return
		end
		local waypoints = path:GetWaypoints()
		if #waypoints < 2 then
			bot.pathMode = "direct"
			return
		end
		bot.pathWaypoints = waypoints
		bot.wpIndex = 2
		bot.pathMode = "path"
		bot.pathTargetPos = goalPos
		bot.lastRepath = os.clock()
	end)
end

local function followPath(hum, hrp)
	if bot.pathMode ~= "path" or bot.pathWaypoints == nil then
		if bot.pathMode == "computing" then
			if bot.fallbackPos ~= nil then
				hum:MoveTo(bot.fallbackPos)
			end
			return
		end
		local root = bot.target ~= nil and getRoot(bot.target) or nil
		local fallback = root ~= nil and root.Position or bot.fallbackPos
		if fallback ~= nil then
			hum:MoveTo(fallback)
		end
		return
	end
	local wp = bot.pathWaypoints[bot.wpIndex]
	while wp ~= nil and (wp.Position - hrp.Position).Magnitude < ARRIVE_EPS do
		bot.wpIndex += 1
		wp = bot.pathWaypoints[bot.wpIndex]
	end
	if wp == nil then
		bot.pathMode = "direct"
		return
	end
	if wp.Action == Enum.PathWaypointAction.Jump then
		hum.Jump = true
	end
	hum:MoveTo(wp.Position)
end

local function stuckCheck(hum, hrp, now)
	if now - bot.lastStuckCheck < 0.25 then
		return
	end
	bot.lastStuckCheck = now
	local velocity = hrp.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	if (bot.state == "CHASE" or bot.state == "ROUTE") and speed < 1.5 then
		bot.stuckTime += 0.25
		if bot.stuckTime > 1.2 and now - (bot.lastJumpAt or 0) > 1.5 then
			hum.Jump = true
			bot.lastJumpAt = now
			log("unstuck: jump")
		end
		if bot.stuckTime > 4 then
			resetPathState()
			bot.pathMode = "direct"
			log("unstuck: force repath")
			bot.stuckTime = 0
		end
	else
		bot.stuckTime = 0
	end
end

local function moveToPosition(hum, hrp, targetPos, now, targetModel)
	bot.fallbackPos = targetPos
	if hasLOS(hrp.Position, targetPos, targetModel) then
		if bot.pathMode ~= "direct" then
			log("checkpoint: LOS clear -> direct MoveTo")
		end
		bot.pathMode = "direct"
		bot.pathWaypoints = nil
		hum:MoveTo(targetPos)
	else
		local cooldown = bot.pathMode == "path" and cfg.repathInterval or 0.5
		local needPath = now - bot.lastRepath > cooldown
			or (bot.pathMode == "path"
				and (targetPos - (bot.pathTargetPos or targetPos)).Magnitude > TARGET_DRIFT)
		if needPath and not bot.pathComputing then
			bot.pathMode = "computing"
			computePathAsync(hrp, targetPos)
		end
		followPath(hum, hrp)
	end
	stuckCheck(hum, hrp, now)
end

local function faceTarget(hrp, targetPos, deltaTime)
	local desired = CFrame.lookAt(
		hrp.Position,
		Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
	)
	local alpha = math.min(deltaTime * 8, 1)
	hrp.CFrame = hrp.CFrame:Lerp(desired, alpha)
end

local lastInfoUpdate = 0
local function updateInfo(now)
	if now - lastInfoUpdate < 0.2 or infoLabel == nil then
		return
	end
	lastInfoUpdate = now
	applyHighlight()
	-- Поле target: только атакуемый (castTarget/target); без боя -> none.
	local focus = nil
	if bot.castTarget ~= nil and bot.castTarget.Parent ~= nil then
		focus = bot.castTarget
	elseif bot.target ~= nil and bot.target.Parent ~= nil then
		focus = bot.target
	end
	local targetText = "none"
	local distText = "-"
	if focus ~= nil then
		local root = getRoot(focus)
		local humanoid = focus:FindFirstChildOfClass("Humanoid")
		local hp = humanoid and math.floor(humanoid.Health / math.max(humanoid.MaxHealth, 1) * 100) or 0
		targetText = ("%s (%d%%)"):format(focus.Name, hp)
		if root ~= nil and bot.hrp ~= nil then
			distText = ("%.1f"):format((root.Position - bot.hrp.Position).Magnitude)
		end
	end
	local count = 0
	for _ in pairs(bot.enemies) do
		count += 1
	end
	-- Индикация режима бега (вместо спид-буста): off / имя режима.
	local runText = (cfg.runMode ~= nil and cfg.runMode ~= "Выкл")
		and ("run:%s"):format(cfg.runMode) or "run:off"
	local duoText = ""
	if cfg.duoRole == "p1" then
		duoText = " | duo: p1"
	elseif cfg.duoRole == "p2" then
		duoText = " | duo: p2 waiting"
	end
	if cfg.duoSaver then
		duoText = duoText .. " | saver"
	end
	if bot.state == "WAIT_PARTY" then
		duoText = duoText .. (" | party %d/%d"):format(bot.partyPresent, bot.partyTotal)
	end
	infoLabel.Text = ("DungeonBot: %s | %s | target: %s | dist: %s | mobs: %d%s"):format(
		cfg.enabled and bot.state or "off",
		runText,
		targetText,
		distText,
		count,
		duoText
	)
	if routeLabel ~= nil then
		local route = getRoute(bot.currentDungeon)
		local wpCount = route ~= nil and #route or 0
		if wpCount > 0 then
			routeLabel.Text = ("route: %s | wp: %d/%d | %s"):format(
				bot.currentDungeon,
				math.min(bot.routeIndex, wpCount),
				wpCount,
				bot.routeDone and "complete"
					or (bot.state == "ROUTE" and "moving"
					or (bot.state == "GATE_HOLD" and "boss gate"
					or (bot.state == "WAIT_SKILLS" and "skills" or "waiting")))
			)
			routeLabel.TextColor3 = (bot.state == "ROUTE" or bot.state == "GATE_HOLD") and Color3.fromRGB(255, 220, 120) or Color3.fromRGB(160, 180, 200)
		else
			routeLabel.Text = "route: none (select dungeon)"
		end
	end
end

-- Duo-детект данжа: реплицированный dungeonName (StringValue) в workspace.
-- Нужен дуо-гейту Heartbeat и авто-старту ниже по файлу.
local function inDungeonNow()
	local dn = workspace:FindFirstChild("dungeonName")
	return dn ~= nil and dn:IsA("StringValue")
end

-- Лобби-место (по id): боевая логика/маршрут/режим бега тут не работают.
local function inLobbyPlace()
	return game.GameId == LOBBY_GAME_ID or game.PlaceId == LOBBY_GAME_ID
end

-- Парсинг строки ников (через запятую/пробел/перенос) в массив.
local function parseNicks(str)
	local list = {}
	if type(str) ~= "string" then
		return list
	end
	for nick in string.gmatch(str, "[^,%s]+") do
		table.insert(list, nick)
	end
	return list
end

-- Гейт «ждать всех игроков»: пока не все прокачиваемые (ники) загрузились в
-- данже — держим стоп и не жмём старт. Снимается, когда все на месте ИЛИ
-- истёк waitPlayersTimeout (фолбэк). Возвращает true = держать стоп.
local function partyGate(now)
	if not cfg.autoLevelEnabled or not cfg.autoWaitPlayers then
		bot.partyWaitSince = nil
		return false
	end
	if not inDungeonNow() then
		bot.partyWaitSince = nil
		return false
	end
	local nicks = parseNicks(cfg.autoLevelNicks)
	if #nicks == 0 then
		bot.partyWaitSince = nil
		return false
	end
	if bot.partyWaitSince == nil then
		bot.partyWaitSince = now
	end
	local present = 0
	for _, nick in ipairs(nicks) do
		local p = Players:FindFirstChild(nick)
		if p ~= nil and p.Character ~= nil
			and p.Character:FindFirstChild("HumanoidRootPart") ~= nil then
			present += 1
		end
	end
	bot.partyPresent = present
	bot.partyTotal = #nicks
	if present >= #nicks then
		return false
	end
	-- Таймаут-фолбэк: кто-то так и не зашёл — стартуем всё равно.
	if now - bot.partyWaitSince > cfg.waitPlayersTimeout then
		if now - bot.partyLoggedAt > 5 then
			bot.partyLoggedAt = now
			log(("party: timeout (%d/%d), starting anyway"):format(present, #nicks))
		end
		return false
	end
	if now - bot.partyLoggedAt > 3 then
		bot.partyLoggedAt = now
		log(("party: waiting players %d/%d"):format(present, #nicks))
	end
	return true
end

local heartbeatConn
heartbeatConn = RunService.Heartbeat:Connect(function(deltaTime)
	local now = os.clock()
	if unloaded then
		return
	end
	if not cfg.enabled then
		updateInfo(now)
		return
	end
	-- В лобби боевой/маршрутный движок отключён (нет данжа): работает только
	-- авто-лвл-апер (свой 0.1с-цикл). Персонаж не бегает по лобби.
	if inLobbyPlace() then
		updateInfo(now)
		return
	end
	local hrp, humanoid = getCharParts()
	bot.hrp = hrp
	if hrp == nil or humanoid == nil or humanoid.Health <= 0 then
		if bot.state ~= "DEAD" then
			bot.state = "DEAD"
			bot.waitUntil = nil
			log("character dead, waiting respawn")
		end
		return
	end

	-- Гейт «ждать всех игроков» (авто-лвл): пока не собрались все прокачиваемые
	-- (ники) — стоим на месте, не фармим и не бежим по маршруту.
	if partyGate(now) then
		bot.state = "WAIT_PARTY"
		bot.target = nil
		bot.castTarget = nil
		bot.waitUntil = nil
		resetPathState()
		humanoid:MoveTo(hrp.Position)
		updateInfo(now)
		return
	end

	-- DUO-гейт (полный стоп):
	-- p1: 6 секунд после входа в данж — стоим, не таргетим, не кастуем.
	-- p2: пока dungeonStarted ~= true — стоим бесконечно, ждём первый игрок.
	if cfg.duoRole ~= "off" and inDungeonNow() then
		local started = workspace:FindFirstChild("dungeonStarted")
		local startedVal = started ~= nil and started:IsA("BoolValue") and started.Value or nil
		if cfg.duoRole == "p2" and startedVal ~= true then
			bot.state = "DUO_WAIT"
			bot.target = nil
			bot.castTarget = nil
			bot.waitUntil = nil
			resetPathState()
			humanoid:MoveTo(hrp.Position)
			if now - bot.duoWaitLoggedAt > 5 then
				bot.duoWaitLoggedAt = now
				log("duo: waiting for player 1...")
			end
			updateInfo(now)
			return
		end
		if cfg.duoRole == "p1" and bot.duoHoldUntil ~= nil then
			if now < bot.duoHoldUntil then
				bot.state = "DUO_HOLD"
				bot.target = nil
				bot.castTarget = nil
				bot.waitUntil = nil
				resetPathState()
				humanoid:MoveTo(hrp.Position)
				if now - bot.duoHoldLoggedAt > 2 then
					bot.duoHoldLoggedAt = now
					log(("duo: p1 holding %.1fs"):format(bot.duoHoldUntil - now))
				end
				updateInfo(now)
				return
			else
				bot.duoHoldUntil = nil
			end
		end
	end

	-- WAIT_SKILLS ПЕРВЫМ: скиллы прожались -> стоим РОВНО кд от момента каста
	-- (безусловное ожидание по таймеру: моб умер — всё равно досиживаем),
	-- лицом к цели, если она жива. Таймер истёк -> сброс и падаем НИЖЕ
	-- в том же кадре — бот мгновенно перекастует без «шага подкрадывания».
	if cfg.waitOnSkills and bot.waitUntil ~= nil then
		if now < bot.waitUntil then
			if bot.state ~= "WAIT_SKILLS" then
				resetPathState()
				log(("wait: holding position %.1fs"):format(bot.waitUntil - now))
			end
			bot.state = "WAIT_SKILLS"
			humanoid:MoveTo(hrp.Position)
			local facePos = nil
			local cRoot = castTargetRoot()
			if cRoot ~= nil then
				facePos = cRoot.Position
			elseif bot.target ~= nil then
				local tRoot = getRoot(bot.target)
				if tRoot ~= nil then
					facePos = tRoot.Position
				end
			end
			if facePos ~= nil then
				if not bot.bodyLocked and humanoid.AutoRotate then
					humanoid.AutoRotate = false
					bot.bodyLocked = true
				end
				faceTarget(hrp, facePos, deltaTime)
			end
			updateInfo(now)
			return
		else
			bot.waitUntil = nil
		end
	end

	-- Ranged-каст: моб в радиусе каста (обычный 90, босс-гейт 80; LOS не
	-- нужен — боссы за барьерами). Аимлок телом. Скиллы стреляют по сигналу
	-- готовности из игры (cooldown <= 0 and not busyCasting) — без таймеров.
	bot.castTarget = nil
	if effectiveCastRange() > 0 then
		local castTarget = findCastTarget(hrp)
		if castTarget ~= nil then
			bot.castTarget = castTarget
			local cRoot = castTargetRoot()
			if cRoot ~= nil then
				if cfg.aimlock and bot.state ~= "IN_RANGE" then
					if not bot.bodyLocked and humanoid.AutoRotate then
						humanoid.AutoRotate = false
						bot.bodyLocked = true
					end
					faceTarget(hrp, cRoot.Position, deltaTime)
				end
				if bot.state ~= "IN_RANGE" then
					fireSkills(now, castTarget.Name)
					-- Каст только что произошёл и включено ожидание -> немедленно
					-- стоим (без остаточного шага CHASE между кадрами).
					if bot.waitUntil ~= nil and now < bot.waitUntil then
						humanoid:MoveTo(hrp.Position)
						updateInfo(now)
						return
					end
				end
			end
		end
	end
	if bot.bodyLocked and (bot.castTarget == nil or bot.state == "IN_RANGE" or not cfg.aimlock) then
		if humanoid.AutoRotate == false then
			humanoid.AutoRotate = true
		end
		bot.bodyLocked = false
	end

	if bot.target == nil or not bot.target:IsDescendantOf(workspace) then
		if bot.target ~= nil then
			log("target lost: " .. bot.target.Name)
			bot.target = nil
			bot.nextRetargetAt = now + rand(0.15, 0.4)
		end
		if now >= bot.nextRetargetAt and now >= bot.nextAcquireAt then
			local best, bestScore = pickTarget()
			if best ~= nil then
				local engage
				local castRange = effectiveCastRange()
				if castRange > 0 then
					-- Моб в радиусе каста (обычный 90 / босс-гейт 80) ->
					-- перестраиваемся на него и подбегаем; LOS-штраф в score
					-- удержит от погони за мобом за барьером.
					engage = bestScore < castRange
				else
					local wp = currentWaypoint()
					local wpDist = wp ~= nil and (wp - hrp.Position).Magnitude or nil
					engage = wpDist == nil or bestScore < wpDist - ENGAGE_MARGIN
				end
				if engage then
					setTarget(best, "acquire")
				else
					bot.nextAcquireAt = now + 0.5
					if now - bot.lastRoutePrefLog > 5 then
						bot.lastRoutePrefLog = now
						log(("route: mob (%.1f) out of cast range -> keep route"):format(bestScore))
					end
				end
			end
		end
		if bot.target == nil then
			local waypoints = getRoute(bot.currentDungeon)
			if waypoints ~= nil and bot.routeIndex <= #waypoints then
				local wpPos, isBoss = wpInfo(waypoints[bot.routeIndex])
				local dist = (wpPos - hrp.Position).Magnitude

				-- Босс-гейт: точка не засчитывается, пока в bossGateRadius от неё
				-- есть живой враг. Смерть не сбрасывает routeIndex — после респавна
				-- бот сам возвращается к этой точке и дерётся, пока гейт закрыт.
				if isBoss and dist < cfg.bossGateRadius and countEnemiesNear(wpPos, cfg.bossGateRadius) > 0 then
					if bot.state ~= "ROUTE" and bot.state ~= "GATE_HOLD" then
						log(("boss gate: enemies at wp %d/%d, holding"):format(bot.routeIndex, #waypoints))
					end
					bot.state = "GATE_HOLD"
					bot.routeDone = false
					bot.routeProgressAt = now
					bot.routeLastWp = nil
					bot.routeLastDist = nil
					moveToPosition(humanoid, hrp, wpPos, now, nil)
					updateInfo(now)
					return
				end

				if bot.state ~= "ROUTE" then
					bot.state = "ROUTE"
					bot.routeDone = false
					resetPathState()
					-- Сброс таймера застревания: бой длился дольше лимита —
					-- отсчёт «нет прогресса» стартует заново, не с до-боевого момента.
					bot.routeLastWp = nil
					bot.routeLastDist = nil
					log(("route: heading to waypoint %d/%d"):format(bot.routeIndex, #waypoints))
				end
				if dist < ROUTE_ARRIVE then
					if isBoss then
						log(("boss gate: cleared, advancing from wp %d/%d"):format(bot.routeIndex, #waypoints))
					else
						log(("route: waypoint %d/%d reached"):format(bot.routeIndex, #waypoints))
					end
					bot.routeIndex += 1
					bot.routeLastWp = nil
					bot.routeLastDist = nil
					resetPathState()
				else
					if bot.routeLastWp ~= bot.routeIndex then
						bot.routeLastWp = bot.routeIndex
						bot.routeLastDist = dist
						bot.routeProgressAt = now
					elseif dist < bot.routeLastDist - 0.5 then
						bot.routeLastDist = dist
						bot.routeProgressAt = now
					elseif cfg.skipStuckWaypoints and now - bot.routeProgressAt > ROUTE_STUCK_SKIP then
						log(("route: waypoint %d no progress, skipping"):format(bot.routeIndex))
						bot.routeIndex += 1
						bot.routeLastWp = nil
						bot.routeLastDist = nil
						resetPathState()
					elseif not cfg.skipStuckWaypoints and now - bot.routeProgressAt > ROUTE_STUCK_SKIP and now - bot.lastRoutePrefLog > 10 then
						bot.lastRoutePrefLog = now
						log(("route: stuck at wp %d (skip disabled)"):format(bot.routeIndex))
					end
					if bot.routeLastWp == bot.routeIndex then
						moveToPosition(humanoid, hrp, wpPos, now, nil)
					end
				end
				updateInfo(now)
				return
			end
			if bot.state ~= "IDLE" then
				bot.state = "IDLE"
				stopMovement()
				if waypoints ~= nil and not bot.routeDone then
					bot.routeDone = true
					log("route complete: " .. tostring(bot.currentDungeon))
				end
			end
			updateInfo(now)
			return
		end
	end

	local root = getRoot(bot.target)
	local targetHumanoid = bot.target:FindFirstChildOfClass("Humanoid")
	if root == nil or targetHumanoid == nil or targetHumanoid.Health <= 0 then
		bot.nextRetargetAt = now + rand(0.15, 0.4)
		setTarget(nil, "died")
		return
	end

	local dist = (root.Position - hrp.Position).Magnitude

	-- Останавливаемся только если в пределах дистанции И чистый LOS:
	-- за барьером продолжаем подходим по пути к мобу вплотную (чекпоинт).
	if dist > cfg.stopDist or not hasLOS(hrp.Position, root.Position, bot.target) then
		bot.state = "CHASE"
		moveToPosition(humanoid, hrp, root.Position, now, bot.target)
	else
		bot.state = "IN_RANGE"
		humanoid:MoveTo(hrp.Position)
		faceTarget(hrp, root.Position, deltaTime)
		fireSkills(now)
	end
	updateInfo(now)
end)

-- Позиционный детектор застревания: персонаж не двигается вовсе (не «медленно
-- идёт», а стоит) — сначала прыжок+перепас, затем скип вейпоинта / смена цели.
local function positionStuckTick()
	local now = os.clock()
	if not cfg.enabled
		or bot.hrp == nil
		or (bot.state ~= "CHASE" and bot.state ~= "ROUTE" and bot.state ~= "GATE_HOLD") then
		bot.posStuckPos = nil
		bot.posStuckTime = 0
		bot.posStuckJumped = false
		return
	end
	local pos = bot.hrp.Position
	if bot.posStuckPos == nil then
		bot.posStuckPos = pos
		bot.posStuckAt = now
		return
	end
	if now - bot.posStuckAt < 1 then
		return
	end
	local moved = (pos - bot.posStuckPos).Magnitude
	bot.posStuckPos = pos
	bot.posStuckAt = now
	if moved >= POS_STUCK_EPS then
		bot.posStuckTime = 0
		bot.posStuckJumped = false
		return
	end
	bot.posStuckTime += 1
	if bot.posStuckTime >= POS_STUCK_DROP then
		bot.posStuckTime = 0
		bot.posStuckJumped = false
		if bot.state == "ROUTE" then
			local wps = getRoute(bot.currentDungeon)
			if cfg.skipStuckWaypoints then
				log(("unstuck: no movement in ROUTE, skip wp %d/%d"):format(
					bot.routeIndex, wps ~= nil and #wps or 0))
				bot.routeIndex += 1
				bot.routeLastWp = nil
				bot.routeLastDist = nil
				resetPathState()
			else
				log(("unstuck: no movement at wp %d (skip disabled), retrying"):format(
					bot.routeIndex))
				resetPathState()
			end
		else
			log("unstuck: no movement, drop target")
			setTarget(nil, "stuck")
			bot.nextRetargetAt = 0
			resetPathState()
		end
	elseif bot.posStuckTime >= POS_STUCK_JUMP and not bot.posStuckJumped then
		bot.posStuckJumped = true
		local _, humanoid = getCharParts()
		if humanoid ~= nil then
			humanoid.Jump = true
		end
		resetPathState()
		log("unstuck: jump + repath")
	end
end

local function computeTimeoutTick()
	if bot.pathComputing and os.clock() - bot.pathComputeStart > COMPUTE_TIMEOUT then
		bot.pathComputing = false
		bot.pathMode = "direct"
		log("path: compute timeout -> direct")
	end
end

-- == Авто-старт / авто-реплей данжа (через ремоуты игры) ==

-- Старт данжа: changeStartValue вызывается БЕЗ аргументов (как игровая кнопка).
local function fireStartRemote()
	local remotesFolder = ReplicatedStorage:FindFirstChild("remotes")
	local remote = remotesFolder and remotesFolder:FindFirstChild("changeStartValue")
	if not (remote and remote:IsA("RemoteEvent")) then
		return false, "changeStartValue not found"
	end
	local ok, err = pcall(function()
		remote:FireServer()
	end)
	return ok, err
end

local function autoStartTick()
	if not cfg.enabled or not cfg.autoStart then
		return
	end
	if not inDungeonNow() then
		bot.inDungeonAt = nil
		bot.startFireCount = 0
		bot.startedPrev = nil
		bot.replayStage = nil
		bot.duoHoldUntil = nil
		return
	end
	local now = os.clock()
	if bot.inDungeonAt == nil then
		bot.inDungeonAt = now
		bot.startFireCount = 0
		bot.replayStage = nil
		-- Duo: плеер 1 при входе в данж держит полный стоп 6 секунд,
		-- только потом жмёт старт (даёт плееру 2 время загрузиться).
		if cfg.duoRole == "p1" then
			bot.duoHoldUntil = now + 6
			log("duo: player 1 holding 6s before start")
		end
		if bot.routeIndex ~= 1 or bot.routeDone then
			resetRoute()
			log("dungeon entered: route reset to wp 1")
		end
	end
	local started = workspace:FindFirstChild("dungeonStarted")
	local startedVal = started ~= nil and started:IsA("BoolValue") and started.Value or nil
	if bot.startedPrev == false and startedVal == true then
		log("auto-start: dungeon started")
	end
	bot.startedPrev = startedVal
	if startedVal == true then
		bot.startFireCount = 0
		return
	end
	-- Duo: плеер 2 НИКОГДА не шлёт старт — ждёт, пока первый стартанёт
	-- (детект по серверной репликации dungeonStarted == true).
	if cfg.duoRole == "p2" then
		return
	end
	local startDelay = 2.5
	if cfg.duoRole == "p1" and bot.duoHoldUntil ~= nil then
		if now < bot.duoHoldUntil then
			return
		end
		bot.duoHoldUntil = nil
	end
	-- Авто-лвл: не стартуем данж, пока не собрались все прокачиваемые (ники).
	if partyGate(os.clock()) then
		return
	end
	if now - bot.inDungeonAt < startDelay then
		return
	end
	if bot.startFireCount >= 8 then
		return
	end
	if now - bot.lastStartFire < 6 then
		return
	end
	local ok, err = fireStartRemote()
	bot.lastStartFire = now
	if ok then
		bot.startFireCount += 1
		log(("auto-start: fired changeStartValue (%d)"):format(bot.startFireCount))
	else
		log("auto-start: failed: " .. tostring(err))
	end
end

-- Копия collectDungeonData() из игрового ReplayDungeonButton: собирает
-- dungeonName / dungeonProgress / dungeonStarted / hardcore + все ValueBase
-- из workspace.dungeon и bossRoom — это и есть полезная нагрузка реплея.
local function collectDungeonData()
	local data = {}
	local dn = workspace:FindFirstChild("dungeonName")
	if dn ~= nil and dn:IsA("StringValue") then
		data.dungeonName = dn.Value
	end
	local dp = workspace:FindFirstChild("dungeonProgress")
	if dp ~= nil and dp:IsA("StringValue") then
		data.dungeonProgress = dp.Value
	end
	local ds = workspace:FindFirstChild("dungeonStarted")
	if ds ~= nil and ds:IsA("BoolValue") then
		data.dungeonStarted = ds.Value
	end
	local hc = workspace:FindFirstChild("hardcore")
	if hc ~= nil and hc:IsA("BoolValue") then
		data.hardcore = hc.Value
		data.isHardcore = hc.Value
	end
	local dungeon = workspace:FindFirstChild("dungeon")
	if dungeon ~= nil then
		for _, child in ipairs(dungeon:GetChildren()) do
			if child:IsA("ValueBase") then
				data[child.Name] = child.Value
			end
		end
		local bossRoom = dungeon:FindFirstChild("bossRoom")
		if bossRoom ~= nil then
			for _, child in ipairs(bossRoom:GetChildren()) do
				if child:IsA("ValueBase") then
					data[child.Name] = child.Value
				end
			end
		end
	end
	return data
end

local function isRunFinished()
	local dungeon = workspace:FindFirstChild("dungeon")
	if dungeon ~= nil then
		local bossRoom = dungeon:FindFirstChild("bossRoom")
		if bossRoom ~= nil then
			local fin = bossRoom:FindFirstChild("dungeonFinished")
			if fin ~= nil and fin:IsA("BoolValue") and fin.Value then
				return true
			end
		end
	end
	local dp = workspace:FindFirstChild("dungeonProgress")
	if dp ~= nil and dp:IsA("StringValue") and dp.Value == "bossKilled" then
		return true
	end
	return false
end

local function fireReplayRemote()
	local remotesFolder = ReplicatedStorage:FindFirstChild("remotes")
	local remote = remotesFolder and remotesFolder:FindFirstChild("replayDungeon")
	if not (remote and remote:IsA("RemoteEvent")) then
		return false, "replayDungeon not found"
	end
	local data = collectDungeonData()
	if data.dungeonName == nil then
		return false, "no dungeonName in workspace"
	end
	local ok, err = pcall(function()
		remote:FireServer(data)
	end)
	return ok, err
end

-- Дроп появился: в PlayerGui.rewardGuiHolder.holder есть предметы (грид-слоты).
local function dropDetected()
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui == nil then
		return false
	end
	local holderGui = playerGui:FindFirstChild("rewardGuiHolder")
	if holderGui == nil then
		return false
	end
	local holder = holderGui:FindFirstChild("holder")
	if holder == nil then
		return holderGui.Enabled
	end
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("GuiObject") then
			return true
		end
	end
	return false
end

-- Реплей: босс убит -> ЖДЁМ ПОЯВЛЕНИЯ ДРОПА (rewardGuiHolder) -> пауза на
-- подбор -> replayDungeon:FireServer(collectDungeonData()) — как кнопка игры.
-- Фолбэк: дропа нет дольше dropWaitMax секунд — реплеем всё равно.
local function autoReplayTick()
	if not cfg.enabled or not cfg.autoReplay then
		bot.replayStage = nil
		return
	end
	local now = os.clock()
	if not isRunFinished() then
		bot.replayStage = nil
		return
	end
	if bot.replayStage == nil then
		bot.replayStage = "waitDrop"
		bot.replayStageAt = now
		log("auto-replay: run finished, waiting for drop...")
		return
	end
	if bot.replayStage == "waitDrop" then
		if dropDetected() then
			bot.replayStage = "dropSeen"
			bot.replayStageAt = now
			log("auto-replay: drop appeared, waiting pickup")
		elseif now - bot.replayStageAt > cfg.dropWaitMax then
			bot.replayStage = "dropSeen"
			bot.replayStageAt = now
			log("auto-replay: no drop detected in timeout, replaying anyway")
		end
		return
	end
	if bot.replayStage == "dropSeen" then
		if now - bot.replayStageAt < cfg.dropPickDelay then
			return
		end
		if now - bot.lastReplayFire < 15 then
			return
		end
		bot.lastReplayFire = now
		bot.replayStage = nil
		local ok, err = fireReplayRemote()
		if ok then
			resetRoute()
			log("auto-replay: fired replayDungeon (route reset to wp 1)")
		else
			log("auto-replay: failed: " .. tostring(err))
		end
	end
end

-- == Авто-лвл-апер (вкладка Auto Level) ==
-- Поток: игрок вписывает ники прокачиваемых аккаунтов и сам запускает данж.
-- Бот в данже читает уровни этих ников (leaderstats.Level), сохраняет их в
-- DungeonBot/levels.json (для будущего отдельного скрипта переключения данжей),
-- авто-подхватывает нужный роут по workspace.dungeonName и, как только мин.
-- уровень перерастает текущий данж (level > maxLvl из LEVEL_DUNGEONS), выходит
-- в лобби (ReturnToLobbyEvent). Заход в следующий данж — отдельный скрипт.

local autoLevelState = {
	levels = {},        -- nick -> level (последнее прочитанное)
	exitFired = false,  -- защита от спама ReturnToLobbyEvent
	lastSaveAt = 0,
	lastLogAt = 0,
	createCooldownAt = 0,   -- троттлинг попыток создания данжа в лобби
	createdForLevel = nil,  -- имя данжа, который уже создали в этом лобби
}

-- Уровень игрока по нику: leaderstats.Level (NumberValue/IntValue). nil если нет.
local function readPlayerLevel(nick)
	local player = Players:FindFirstChild(nick)
	if player == nil then
		return nil
	end
	local ls = player:FindFirstChild("leaderstats")
	if ls == nil then
		return nil
	end
	local lvl = ls:FindFirstChild("Level")
	if lvl ~= nil and lvl:IsA("ValueBase") and type(lvl.Value) == "number" then
		return lvl.Value
	end
	return nil
end

-- Сохранение прочитанных уровней в DungeonBot/levels.json (персональный файл).
local function saveLevels()
	if writefile == nil then
		return
	end
	pcall(function()
		makefolder("DungeonBot")
	end)
	pcall(function()
		local path = "DungeonBot/levels.json"
		writefile(path, game:GetService("HttpService"):JSONEncode(autoLevelState.levels))
	end)
end

-- Запись в лобби: ремоут ReturnToLobbyEvent (из дампа — так жмёт кнопку игры).
local function fireReturnToLobby()
	local remotesFolder = ReplicatedStorage:FindFirstChild("remotes")
	local remote = remotesFolder and remotesFolder:FindFirstChild("ReturnToLobbyEvent")
	if not (remote and remote:IsA("RemoteEvent")) then
		return false, "ReturnToLobbyEvent not found"
	end
	local ok, err = pcall(function()
		remote:FireServer()
	end)
	return ok, err
end

-- Диапазон уровней для данжа из LEVEL_DUNGEONS (по имени из dungeonDropdown).
local function levelDungeonInfo(name)
	for _, entry in ipairs(LEVEL_DUNGEONS) do
		if entry.name == name then
			return entry
		end
	end
	return nil
end

-- Данж по уровню (диапазон содержит level). nil если вне 70–129.
local function pickDungeonForLevel(level)
	for _, entry in ipairs(LEVEL_DUNGEONS) do
		if level >= entry.minLvl and level <= entry.maxLvl then
			return entry
		end
	end
	return nil
end

-- Сложность по уровню: первая половина бэнда (X0–X4) = Insane, вторая
-- (X5–X9) = Nightmare. Хардкор при создании включается всегда (отдельно).
local function pickDifficultyForLevel(level)
	return (level % 10) < 5 and "Insane" or "Nightmare"
end

-- == Создание данжа в лобби (firesignal по UI queueGui) ==
-- Тайлы данжа/сложности/хардкора — ImageLabel (не кнопки): клик игра ловит
-- через InputBegan. Поэтому firesignal по MouseButton1Click/Activated (для
-- TextButton вроде createGame и кнопок dropdown) + перебор getconnections
-- InputBegan с синтетическим InputObject (для ImageLabel-тайлов).
local function fireGuiClick(obj)
	if obj == nil then
		return false
	end
	local fired = false
	if firesignal ~= nil then
		for _, sigName in ipairs({ "MouseButton1Click", "Activated" }) do
			local ok, sig = pcall(function()
				return obj[sigName]
			end)
			if ok and sig ~= nil then
				pcall(function()
					firesignal(sig)
					fired = true
				end)
			end
		end
	end
	if getconnections ~= nil then
		local fakeInput = {
			UserInputType = Enum.UserInputType.MouseButton1,
			UserInputState = Enum.UserInputState.Begin,
		}
		for _, sigName in ipairs({ "InputBegan", "MouseButton1Down", "MouseButton1Up" }) do
			local ok, sig = pcall(function()
				return obj[sigName]
			end)
			if ok and sig ~= nil then
				local ok2, conns = pcall(getconnections, sig)
				if ok2 and type(conns) == "table" then
					for _, conn in ipairs(conns) do
						pcall(function()
							conn:Fire(fakeInput)
						end)
						fired = true
					end
				end
			end
		end
	end
	return fired
end

local function getQueueGui()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg == nil then
		return nil
	end
	return pg:FindFirstChild("queueGui")
end

-- Создание данжа: выбрать данж в dungeonDropdown -> сложность -> хардкор ВКЛ
-- -> createGame. Возвращает true, если дошли до клика по createGame.
local function createDungeon(name, difficulty, hardcore)
	local queueGui = getQueueGui()
	if queueGui == nil then
		return false, "queueGui not found"
	end
	-- 1) Данж через dropdown: открыть, найти опцию по label.Text, клик button.
	local dropdown = queueGui:FindFirstChild("dungeonDropdown", true)
	if dropdown ~= nil then
		local ddButton = dropdown:FindFirstChild("button")
		if ddButton ~= nil then
			fireGuiClick(ddButton)
		end
		local options = dropdown:FindFirstChild("options", true)
		if options ~= nil then
			for _, opt in ipairs(options:GetChildren()) do
				if opt.Name ~= "optionTemplate" and not opt:IsA("UIListLayout") then
					local label = opt:FindFirstChild("label", true)
					local btn = opt:FindFirstChild("button", true)
						or (opt:IsA("GuiButton") and opt or nil)
					if label ~= nil and label:IsA("TextLabel")
						and label.Text == name and btn ~= nil then
						fireGuiClick(btn)
						break
					end
				end
			end
		end
	end
	task.wait(0.1)
	-- 2) Сложность: тайл Insane/Nightmare в difficultyPanel.
	local diffPanel = queueGui:FindFirstChild("difficultyPanel", true)
	if diffPanel ~= nil and difficulty ~= nil then
		local tile = diffPanel:FindFirstChild(difficulty)
		if tile ~= nil then
			fireGuiClick(tile)
		end
	end
	task.wait(0.1)
	-- 3) Хардкор ВКЛ (всегда при создании в лобби).
	if hardcore then
		local hcSection = queueGui:FindFirstChild("hardcoreSection", true)
		local hc = (hcSection ~= nil and (hcSection:FindFirstChild("hardcore", true) or hcSection))
			or queueGui:FindFirstChild("hardcore", true)
		if hc ~= nil then
			fireGuiClick(hc)
		end
	end
	task.wait(0.1)
	-- 4) Create Dungeon.
	local createBtn = queueGui:FindFirstChild("createGame", true)
	if createBtn == nil then
		return false, "createGame not found"
	end
	fireGuiClick(createBtn)
	return true
end

-- Сохранение «следующей цели» для отдельного скрипта захода (join).
