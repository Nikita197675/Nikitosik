-- DungeonBot.lua — легитный тестер-бот для данжей.
-- Фаза 1: подбегание к мобам. Фаза 2: скиллы КАК РЕАЛЬНЫЙ ИГРОК — нажатие
-- слота q/e: tool.localEvent:Fire() (локальная анимация) + remotes.abilityUsed
-- :FireServer(slot, tool) — тот же путь, что у игры при нажатии клавиши, с
-- видимой анимацией. Во вкладке Main выбирается способность для слота 1 (Q) и
-- слота 2 (E) из списка SKILL_NAMES; жмётся слот, если его Tool = выбранному
-- имени и готов (cooldown <= 0, не busyCasting).
-- Движение: ТОЛЬКО Humanoid:MoveTo (штатный путь, реплицируется как обычная ходьба).
-- Режим бега (вкладка Auto Level): ускоряющий скилл вместо спид-буста — бот
-- поочерёдно НАЖИМАЕТ слоты q/e (Pulse Waves) как реальный игрок (localEvent +
-- abilityUsed, с анимацией) со встроенным таймингом 2.9с; оба держатся вне кд
-- (кд 4с) → персонаж бежит без остановки.
-- Реестр RUN_MODES; новые режимы бега добавляются по образцу.
-- Авто-лвл-апер (вкладка Auto Level): вписываешь ники прокачиваемых аккаунтов
-- и сам запускаешь данж; в данже бот подхватывает роут по workspace.dungeonName,
-- читает уровни ников (leaderstats.Level), сохраняет в DungeonBot/levels.json и,
-- как только мин. уровень перерастает текущий данж (level > maxLvl из
-- LEVEL_DUNGEONS, диапазоны 70–130), выходит в лобби (ReturnToLobbyEvent).
-- Заход в следующий данж — отдельный скрипт (позже).
-- Автостарт: бот включён сразу при загрузке; настройки (данж, мастер, тумблеры,
-- слайдеры, стоп-дистанция/каст, способности в слотах) хранятся в
-- DungeonBot/config.json (вкладка Config: сохранить/загрузить/сброс, автосейв
-- при каждом изменении) и автоматически применяются при старте скрипта.
-- Авто-старт/реплей данжа (вкладка Auto): в данже бот сам жмёт старт через ремоут
-- changeStartValue (БЕЗ аргументов — как кнопка игры); после убийства босса ЖДЁТ
-- появления дропа (rewardGuiHolder.holder), пауза на подбор, затем шлёт
-- replayDungeon с данными воркспейса — полный цикл без кликов.
-- Таргетинг: перепроверка ближайшего каждые retargetInterval (гистерезис 20%);
-- моб за невидимым барьером = +30 studs штрафа в рейтинге; чекпоинты: как только
-- LOS чист при следовании по пути — мгновенный переход на прямой MoveTo.
-- Маршруты: таблица DUNGEONS (route = полный порядок точек; строго wp N -> N+1).
-- В бой вступаем при мобе в castRange (дефолт 90 — Northern Lands, мобы агрятся
-- дальше). Босс-гейты (Northern Lands): точка {pos=.., boss=true} не
-- засчитывается, пока в bossGateRadius от неё есть живой враг; смерть не
-- сбрасывает routeIndex — после респавна бот возвращается к гейту.
-- WAIT_SKILLS: скиллы прожались -> бот стоит cooldownLength от момента каста
-- (длительность из игры) -> бежит. Кулдаун — СИГНАЛЬНЫЙ (из дампов Tool'ов):
-- tool.cooldown (NumberValue, сервер) и busyCasting на персонаже — готовность
-- читается из игры, НОЛЬ ТАЙМЕРОВ (реестра кд больше нет: сервер сам отвечает
-- готовностью); потерянная из-за пинга ремотка повторяется сама.
-- Каст = нажатие слота: localEvent:Fire() + abilityUsed:FireServer(slot, tool).
-- Аимлок — ТОЛЬКО телом (камеру не трогаем, игра без шифтлока).
-- DUO-режим (вкладка Duo): плеер 1 при входе в данж держит полный стоп 6с,
-- затем стартует (changeStartValue); плеер 2 никогда не стартует сам и стоит
-- до серверной репликации dungeonStarted == true (первый стартанул).
-- Роль хранится в конфиге (duoRole: off/p1/p2) — переживает реплей-телепорт.
-- Death-sync (отдельный тумблер duoDeathSync, без привязки к роли): партнёр
-- умер в данже — мой перс умирает вместе с ним (Health=0 + BreakJoints),
-- оба респаунятся и продолжают цикл; edge-детект + кулдаун 5с от пинг-понга.
-- Сейвер (отдельный тумблер duoSaver, без привязки к роли): работает ВСЕГДА,
-- даже при выключенном мастере. 3 поля UserId (saverId1/2/3) — белый список.
-- Если на сервере есть игрок, не совпадающий ни с одним вписанным ID —
-- LocalPlayer:Kick("saved"). Вписано 3, онлайн меньше — продолжаем (не кикаем);
-- свой UserId тоже надо вписать, иначе кикнет самого себя. Поля: только числа.
-- Запуск: executor'ом. GUI: Rayfield (loadstring подтягивается сам).
-- Если Rayfield не загрузился — переключение бота клавишей B.
-- Авто-скрытие меню (тумблер hideOnExecute, вкладка Config): при экзекуе меню
-- не показывается ВООБЩЕ (ScreenGui выключается до интро Rayfield, затем
-- корректно переводится в Hidden) — K поднимет его обратно. По умолчанию выкл.
-- Авто-перезапуск (только онлайн): queue_on_teleport грузит скрипт по
-- REMOTE_URL (GitHub raw) — после телепорта/перезахода бот поднимается сам;
-- тумблер autoRestart (вкладка Config) включает/выключает, постановка — после
-- загрузки конфига. Конфиг применяется ПЕРВЫМ делом при каждом старте.

-- Запрещённые place/game id: в этих играх скрипт не запускается вообще.
local BLOCKED_GAME_IDS = {}

-- Лобби (place/game id): здесь НЕТ данжа — работает только авто-лвл-апер
-- (чтение уровней + создание данжа на некст уровень). Боевая логика/маршрут
-- и режим бега в лобби отключены, чтобы персонаж не бегал по лобби.
local LOBBY_GAME_ID = 77649408247578

if BLOCKED_GAME_IDS[game.GameId] or BLOCKED_GAME_IDS[game.PlaceId] then
	return
end

if _G.__DUNGEON_BOT_ACTIVE then
	return
end
_G.__DUNGEON_BOT_ACTIVE = true

-- == Авто-перезапуск после телепорта/перезахода (только онлайн, GitHub) ==
-- Реплей данжа = телепорт на новый сервер, executor уничтожает скрипт.
-- queue_on_teleport ставит загрузчик: после телепорта он дожидается загрузки
-- игры и тянет скрипт по REMOTE_URL (GitHub raw) — бот поднимается сам,
-- без autoexec и без локальных файлов. Обновления = коммит в репозиторий.
-- В запрещённые игры (BLOCKED_GAME_IDS) загрузчик не выполняется.
-- Тумблер cfg.autoRestart (вкладка Config): загрузчик ставится ПОСЛЕ загрузки
-- конфига — учитывает сохранённое значение; вкл в рантайме ставит немедленно.

local REMOTE_URL = "https://raw.githubusercontent.com/Nikita197675/Nikitosik/refs/heads/main/dungeonbot"
local boot = { supported = false, queued = false, loader = nil }

local function queueTeleport(str)
	local fn = queue_on_teleport or queueonteleport
		or (getgenv and (getgenv().queue_on_teleport or getgenv().queueonteleport))
	if fn == nil then
		return false
	end
	local ok = pcall(fn, str)
	return ok
end

do
	-- Загрузчик: ждёт игру/игрока, проверяет запрещённые id, тянет скрипт
	-- по URL с ретраями. Строку готовим здесь, ВЫЗОВ queueTeleport — после
	-- загрузки конфига (учитывает тумблер autoRestart).
	boot.supported = queue_on_teleport ~= nil or queueonteleport ~= nil
		or (getgenv ~= nil and (getgenv().queue_on_teleport ~= nil or getgenv().queueonteleport ~= nil))
	local blockedIds = {}
	for id in pairs(BLOCKED_GAME_IDS) do
		table.insert(blockedIds, ("[%s] = true"):format(id))
	end
	local blockedTable = "{" .. table.concat(blockedIds, ", ") .. "}"
	boot.loader = ([[
		repeat task.wait(0.1) until game:IsLoaded()
		local Players = game:GetService("Players")
		while Players.LocalPlayer == nil do
			task.wait(0.1)
		end
		task.wait(2)
		local blocked = %s
		if blocked[game.GameId] or blocked[game.PlaceId] then
			return
		end
		for _ = 1, 10 do
			local ok = pcall(function()
				loadstring(game:HttpGet(%q))()
			end)
			if ok then
				return
			end
			task.wait(1)
		end
	]]):format(blockedTable, REMOTE_URL)
end

