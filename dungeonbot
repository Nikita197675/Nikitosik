	if type(wp) == "table" then
		return wp.pos, wp.boss == true
	end
	return nil, false
end

local function currentWaypoint()
	local wps = getRoute(bot.currentDungeon)
	if wps == nil or bot.routeIndex > #wps then
		return nil
	end
	local pos, isBoss = wpInfo(wps[bot.routeIndex])
	return pos, isBoss
end

