-- Мин. уровень прокачиваемых ников (онлайн), с записью в autoLevelState.levels.
local function readTrackedMinLevel()
	local nicks = parseNicks(cfg.autoLevelNicks)
	if #nicks == 0 then
		return nil
	end
	local minLevel = nil
	for _, nick in ipairs(nicks) do
		local lvl = readPlayerLevel(nick)
		if lvl ~= nil then
			autoLevelState.levels[nick] = lvl
			if minLevel == nil or lvl < minLevel then
				minLevel = lvl
			end
		end
	end
	return minLevel
end

-- Быстрый тик авто-лвла (0.1с): ловим лвл-апы прокачиваемых аккаунтов до того,
-- как они выйдут. В данже — чтение уровней + выход в лобби при перерастании.
-- В лобби — создание данжа на некст уровень (+ хардкор всегда).
local function autoLevelTick()
	if not cfg.autoLevelEnabled then
		autoLevelState.exitFired = false
		autoLevelState.createdForLevel = nil
		return
	end
	local now = os.clock()

	-- Непрерывное сохранение уровней на диск (троттлинг 1с), чтобы отдельный
	-- скрипт видел актуальные значения; в память пишем на каждом тике.
	local minLevel = readTrackedMinLevel()
	if now - autoLevelState.lastSaveAt > 1 then
		autoLevelState.lastSaveAt = now
		saveLevels()
	end

	-- ЛОББИ: создаём данж на некст уровень.
	if not inDungeonNow() then
		autoLevelState.exitFired = false
		if not cfg.autoCreate or minLevel == nil then
			return
		end
		local entry = pickDungeonForLevel(minLevel)
		if entry == nil then
			if now - autoLevelState.lastLogAt > 15 then
				autoLevelState.lastLogAt = now
				log(("auto-level: lvl %d вне диапазона 70–129 — создание пропущено"):format(minLevel))
			end
			return
		end
		if autoLevelState.createdForLevel == entry.name then
			return
		end
		if now - autoLevelState.createCooldownAt < 8 then
			return
		end
		autoLevelState.createCooldownAt = now
		local diff = pickDifficultyForLevel(minLevel)
		saveNextTarget({
			dungeon = entry.name,
			difficulty = diff,
			hardcore = cfg.autoHardcore,
			level = minLevel,
		})
		log(("auto-level: lobby -> create %s / %s / hardcore=%s (lvl %d)"):format(
			entry.name, diff, tostring(cfg.autoHardcore), minLevel))
		task.spawn(function()
			local ok, err = createDungeon(entry.name, diff, cfg.autoHardcore)
			if ok then
				autoLevelState.createdForLevel = entry.name
				log("auto-level: createDungeon fired")
			else
				log("auto-level: createDungeon failed: " .. tostring(err))
			end
		end)
		return
	end

	-- В ДАНЖЕ: сброс лобби-защиты + авто-подхват роута.
	autoLevelState.createdForLevel = nil
	local dnValue = nil
	local dn = workspace:FindFirstChild("dungeonName")
	if dn ~= nil and dn:IsA("StringValue") then
		dnValue = dn.Value
	end
	if dnValue ~= nil and DUNGEONS[dnValue] ~= nil and bot.currentDungeon ~= dnValue then
		bot.currentDungeon = dnValue
		resetRoute()
		log("auto-level: route -> " .. dnValue)
	end

	if minLevel == nil then
		if now - autoLevelState.lastLogAt > 10 then
			autoLevelState.lastLogAt = now
			log("auto-level: tracked nicks not found online yet")
		end
		return
	end

	-- Выход в лобби: мин. уровень перерос текущий данж (level > maxLvl).
	local info = dnValue ~= nil and levelDungeonInfo(dnValue) or nil
	if info ~= nil and minLevel > info.maxLvl and not autoLevelState.exitFired then
		autoLevelState.exitFired = true
		saveLevels()
		local ok, err = fireReturnToLobby()
		if ok then
			log(("auto-level: lvl %d > %s (max %d) -> return to lobby"):format(
				minLevel, dnValue, info.maxLvl))
		else
			log("auto-level: return to lobby failed: " .. tostring(err))
			autoLevelState.exitFired = false
		end
	end
end

