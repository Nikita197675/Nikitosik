-- == Режим бега: поочерёдное НАЖАТИЕ слота ускоряющего скилла (как игрок) ==
-- Pulse Waves: слоты q/e; бот жмёт их по очереди каждые mode.interval (2.9с)
-- через pressAbility (localEvent:Fire + abilityUsed:FireServer) — С АНИМАЦИЕЙ,
-- как реальное нажатие клавиши. Работает всегда (бой+бег), пока бот включён
-- и жив; в лобби отключён.
local function getRunModeSlots(toolName)
	local slots = {}
	for _, slot in ipairs({ "q", "e" }) do
		local tool = findSlotTool(slot)
		if tool ~= nil and tool.Name == toolName then
			table.insert(slots, slot)
		end
	end
	return slots
end

local runSlotIndex = 0
task.spawn(function()
	while not unloaded do
		local mode = runModeByName(cfg.runMode)
		if mode == nil or mode.toolName == nil or not cfg.enabled or inLobbyPlace() then
			runSlotIndex = 0
			task.wait(0.3)
		else
			local _, humanoid = getCharParts()
			if humanoid == nil or humanoid.Health <= 0 then
				task.wait(0.3)
			else
				local slots = getRunModeSlots(mode.toolName)
				if #slots == 0 then
					task.wait(0.3)
				else
					runSlotIndex = runSlotIndex % #slots + 1
					pressAbility(slots[runSlotIndex])
					task.wait(mode.interval or 2.9)
				end
			end
		end
	end
end)

