-- == Синхронизация смерти (вкладка Duo: независимый тумблер duoDeathSync) ==
-- Если партнёр умер — мой персонаж умирает вместе с ним (reset character),
-- оба респаунятся и продолжают цикл. Работает БЕЗ привязки к duoRole.
-- Детект: edge-переход живой -> мёртвый по Humanoid.Health партнёра
-- (нужно предварительно увидеть его живым — не срабатывает на трупе при
-- загрузке). Сброс: Health = 0, фолбэк BreakJoints через 0.15с (клиент
-- владеет своими частями — реплицируется). Кулдаун DUO_SYNC_COOLDOWN после
-- сброса гасит пинг-понг ресетов между двумя ботами.

local DUO_SYNC_COOLDOWN = 5

local function findDuoPartner()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			return player
		end
	end
	return nil
end

local function resetOwnCharacter()
	local character = LocalPlayer.Character
	if character == nil then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return
	end
	humanoid.Health = 0
	-- Фолбэк: если здоровье сервер-авторитарно и не обнулилось — ломаем суставы
	-- (клиент владеет своими частями, BreakJoints реплицируется серверу).
	task.delay(0.15, function()
		local char = LocalPlayer.Character
		if char == nil then
			return
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum ~= nil and hum.Health > 0 then
			char:BreakJoints()
		end
	end)
end

task.spawn(function()
	while not unloaded do
		task.wait(0.1)
		if not cfg.enabled or not cfg.duoDeathSync or not inDungeonNow() then
			duoSync.partner = nil
			duoSync.wasAlive = false
		else
			local partner = duoSync.partner
			if partner == nil or partner.Parent == nil then
				partner = findDuoPartner()
				duoSync.partner = partner
				duoSync.wasAlive = false
			end
			if partner ~= nil then
				local character = partner.Character
				local humanoid = character ~= nil and character:FindFirstChildOfClass("Humanoid") or nil
				if humanoid == nil then
					duoSync.wasAlive = false
				elseif humanoid.Health > 0 then
					duoSync.wasAlive = true
				elseif duoSync.wasAlive then
					-- Партнёр только что умер — ресаем своего перса.
					duoSync.wasAlive = false
					local now = os.clock()
					if now - duoSync.resetAt >= DUO_SYNC_COOLDOWN then
						duoSync.resetAt = now
						log("duo: partner died, resetting own character")
						resetOwnCharacter()
					end
				end
			end
		end
	end
end)

-- == Сейвер (вкладка Duo: независимый тумблер duoSaver) ==
-- Работает ВСЕГДА — без привязки к мастер-вкл и роли в дуо. Белый список из
-- 3 UserId (saverId1/2/3 во вкладке Duo). Раз в секунду перебираем игроков:
-- нашли человека, чей UserId не совпадает ни с одним вписанным — кикаем
-- СВОЕГО перса с причиной "saved" (LocalPlayer:Kick). Вписано 3, а онлайн
-- меньше — НЕ кикаем (список не обязан быть полностью в онлайне). Свой
-- UserId тоже нужно вписать — иначе кикнет самого себя при старте. Пустые
-- и нечисловые поля игнорируются; если список пуст — сейвер не активен.

local duoCheck = {
	offender = nil,
	loggedAt = 0,
}

-- Собирает set валидных UserId из конфига: { [userId] = true }.
local function collectSaverIds()
	local ids = {}
	for _, key in ipairs({ "saverId1", "saverId2", "saverId3" }) do
		local raw = cfg[key]
		if type(raw) == "string" or type(raw) == "number" then
			-- gsub возвращает (строка, кол-во замен): присвоение в локал
			-- обрезает multiple-return до одного значения, иначе tonumber
			-- примет кол-во замен как base системы счисления -> error.
			local cleaned = tostring(raw):gsub("%s+", "")
			local n = tonumber(cleaned)
			if n ~= nil and n == math.floor(n) and n > 0 then
				ids[n] = true
			end
		end
	end
	return ids
end

task.spawn(function()
	while not unloaded do
		task.wait(1)
		if not cfg.duoSaver then
			duoCheck.offender = nil
		else
			local allowed = collectSaverIds()
			local offender = nil
			for _, player in ipairs(Players:GetPlayers()) do
				if not allowed[player.UserId] then
					offender = player
					break
				end
			end
			if offender ~= nil then
				if duoCheck.offender ~= offender then
					duoCheck.offender = offender
					duoCheck.loggedAt = os.clock()
					log(("duo: saver: stranger %s (%d) online, kicking (saved)"):format(
						tostring(offender.Name), offender.UserId))
				end
				-- Кик всегда (упавший в прошлый раз повторится), лог — редко.
				local ok = pcall(function()
					LocalPlayer:Kick("saved")
				end)
				if not ok and os.clock() - duoCheck.loggedAt > 10 then
					duoCheck.loggedAt = os.clock()
					log("duo: kick failed, retrying")
				end
			else
				duoCheck.offender = nil
			end
		end
	end
end)

-- == Авто-перенос инвентаря в сторейдж (вкладка Storage) ==
-- Данные из ремоутов (по дампам игры): reloadInvy / getPlayerStorage ->
-- {weapons, abilities, chests, helmets} с ключами вида "weapon_123".
-- Перенос: moveItemToStorage:InvokeServer(itemType, id) — 1 вещь в секунду,
-- пока инвентарь не опустеет до 10. Экипированное (серверный флаг equipped:
-- bool у вещей, {q/e/q2/e2} у способностей) не переносится.
-- Сторейдж 125 мест: полный -> перенос не стартует; 3 неудачи подряд -> стоп.

local STORAGE_CAP = 125
local TRANSFER_TARGET_MIN = 10
local TRANSFER_DELAY = 1

local STORAGE_CATEGORIES = { "weapons", "abilities", "chests", "helmets" }
local STORAGE_TYPE = {
	weapons = "weapon",
	abilities = "ability",
	chests = "chest",
	helmets = "helmet",
}

local storageState = {
	moving = false,
	totalMoved = 0,
	failStreak = 0,
	blocked = false,
}

local function storageRemote(name)
	local remotes = ReplicatedStorage:FindFirstChild("remotes")
	if remotes == nil then
		return nil
	end
	local r = remotes:FindFirstChild(name)
	if r ~= nil and r:IsA("RemoteFunction") then
		return r
	end
	return nil
end

local function storageFetch(name)
	local r = storageRemote(name)
	if r == nil then
		return nil
	end
	local ok, result = pcall(function()
		return r:InvokeServer()
	end)
	if not ok or type(result) ~= "table" then
		return nil
	end
	return result
end

local function storageFlatten(data)
	local list = {}
	for _, cat in ipairs(STORAGE_CATEGORIES) do
		local items = type(data[cat]) == "table" and data[cat] or nil
		if items ~= nil then
			for key, item in pairs(items) do
				local id = tostring(key):match("_(.+)$")
				if id ~= nil then
					table.insert(list, {
						key = tostring(key),
						type = STORAGE_TYPE[cat],
						id = id,
						item = item,
					})
				end
			end
		end
	end
	return list
end

local function storageIsEquipped(entry)
	local item = entry.item
	if type(item) ~= "table" then
		return false
	end
	if entry.type == "ability" then
		local eq = item.equipped
		if type(eq) == "table" then
			for _, slotName in ipairs({ "q", "e", "q2", "e2" }) do
				if eq[slotName] == true then
					return true
				end
			end
		end
		return false
	end
	return item.equipped == true
end

local function storageRun()
	storageState.moving = true
	storageState.failStreak = 0
	local moved = 0
	while cfg.enabled and cfg.autoTransfer and not storageState.blocked do
		local data = storageFetch("reloadInvy")
		if data == nil then
			task.wait(2)
		else
			local list = storageFlatten(data)
			if #list <= TRANSFER_TARGET_MIN then
				break
			end
			local chosen = nil
			for _, entry in ipairs(list) do
				if not storageIsEquipped(entry) then
					chosen = entry
					break
				end
			end
			if chosen == nil then
				break
			end
			local r = storageRemote("moveItemToStorage")
			if r == nil then
				break
			end
			local ok, result = pcall(function()
				return r:InvokeServer(chosen.type, chosen.id)
			end)
			if ok and result then
				storageState.failStreak = 0
				moved += 1
				if moved % 25 == 0 then
					log(("storage: %d moved, inv %d"):format(moved, #list))
				end
			else
				storageState.failStreak += 1
				if storageState.failStreak >= 3 then
					storageState.blocked = true
					log("storage: full (3 fails), stopped")
					break
				end
			end
			task.wait(TRANSFER_DELAY)
		end
	end
	storageState.moving = false
	if moved > 0 then
		storageState.totalMoved += moved
		log(("storage: done, moved %d (total %d)"):format(moved, storageState.totalMoved))
	end
end

task.spawn(function()
	while not unloaded do
		task.wait(2)
		if cfg.enabled and cfg.autoTransfer
			and not storageState.moving and not storageState.blocked then
			local data = storageFetch("reloadInvy")
			if data ~= nil then
				local list = storageFlatten(data)
				if #list >= cfg.transferThreshold then
					local st = storageFetch("getPlayerStorage")
					if st ~= nil then
						local stList = storageFlatten(st)
						if #stList >= STORAGE_CAP then
							storageState.blocked = true
							log(("storage: full (%d/%d), not transferring"):format(#stList, STORAGE_CAP))
						end
					end
					if not storageState.blocked then
						log(("storage: transfer started (%d items)"):format(#list))
						task.spawn(storageRun)
					end
				end
			end
		end
	end
end)

local function setupCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	bot.hrp = hrp
	if humanoid == nil or hrp == nil then
		return
	end
	humanoid.Died:Connect(function()
		bot.state = "DEAD"
		bot.target = nil
		bot.waitUntil = nil
		resetPathState()
		log("died")
	end)
	bot.state = "IDLE"
	log("character ready")
	if cfg.enabled and not bot.started then
		bot.started = true
		task.delay(0.5, function()
			if cfg.enabled then
				setEnabled(true)
			end
		end)
	end
end

