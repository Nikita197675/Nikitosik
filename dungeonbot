			Content = "Независимый тумблер — работает ВСЕГДА, даже при выключенном мастере и без выбора роли. Белый список: 3 поля с UserId друзей. Если на сервере появляется игрок, которого НЕТ в списке — бот кикает сам себя с причиной «saved». Вписано 3, а онлайн меньше — бот продолжает работать (список не обязан быть полностью в онлайне). Свой собственный UserId тоже нужно вписать, иначе бот кикнет сам себя при старте. Пустые и нечисловые поля игнорируются; если список пуст — сейвер не активен. Настройки сохраняются в конфиг.",
		})
	end)

	configTab:CreateButton({
		Name = "Сохранить конфиг сейчас",
		Callback = function()
			saveConfig()
		end,
	})

	-- Полная выгрузка: гасим флаг (все while-циклы выходят), дисконнектим
	-- Heartbeat, останавливаем перса, чистим GUI/маркеры/подсветку и
	-- уничтожаем окно Rayfield. После — скрипт можно запустить заново.
	local function doUnload()
		unloaded = true
		cfg.enabled = false
		pcall(function()
			if heartbeatConn ~= nil then
				heartbeatConn:Disconnect()
			end
		end)
		pcall(stopMovement)
		pcall(function()
			setSpawnMarkers(false)
		end)
		local _, hum = getCharParts()
		if hum ~= nil then
			pcall(function()
				hum.AutoRotate = true
			end)
		end
		pcall(function()
			if highlight ~= nil then
				highlight:Destroy()
			end
		end)
		pcall(function()
			if hudGui ~= nil then
				hudGui:Destroy()
			end
		end)
		_G.__DUNGEON_BOT_ACTIVE = false
		log("unloaded")
		pcall(function()
			Rayfield:Destroy()
		end)
	end

	configTab:CreateButton({
		Name = "ВЫГРУЗИТЬ (Unload)",
		Callback = function()
			doUnload()
		end,
	})

	configTab:CreateButton({
		Name = "Загрузить конфиг из файла (в логику)",
		Callback = function()
			local ok = loadConfig()
			if not ok then
				log("config load: no file or read failed")
			end
		end,
	})

	configTab:CreateToggle({
		Name = "Авто-сохранение при изменениях",
		CurrentValue = cfg.autoSave,
		Flag = "dbot_autosave",
		Callback = function(value)
			cfg.autoSave = value
			log("auto save: " .. tostring(value))
			if value then
				scheduleSave()
			end
		end,
	})

	configTab:CreateToggle({
		Name = "Прятать меню при загрузке (K — показать)",
		CurrentValue = cfg.hideOnExecute,
		Flag = "dbot_hideonexecute",
		Callback = function(value)
			cfg.hideOnExecute = value
			log("hide on execute: " .. tostring(value))
			scheduleSave()
		end,
	})

	configTab:CreateButton({
		Name = "Сбросить конфиг к дефолтам (удалить файл)",
		Callback = function()
			local ok = pcall(function()
				local path = configFilePath()
				if delfile ~= nil then
					delfile(path)
				else
					writefile(path, "{}")
				end
			end)
			log(ok and "config file reset (restart script for defaults)" or "config reset failed")
		end,
	})

	configTab:CreateToggle({
		Name = "Авто-загрузка после телепорта (GitHub)",
		CurrentValue = cfg.autoRestart,
		Flag = "dbot_autorestart",
		Callback = function(value)
			cfg.autoRestart = value
			if value and not boot.queued and boot.loader ~= nil then
				boot.queued = queueTeleport(boot.loader)
			end
			if value then
				log("auto restart: on" .. (boot.queued and " (queued)" or " (queue failed)"))
			else
				log("auto restart: off (действует с этого запуска; уже поставленный загрузчик не убрать)")
			end
			scheduleSave()
		end,
	})

	configTab:CreateButton({
		Name = "Авто-перезапуск после перезахода: статус",
		Callback = function()
			log("autorestart: queue_on_teleport " .. (boot.supported and "supported" or "NOT supported by executor"))
			log("autorestart: remote " .. REMOTE_URL)
			log("autorestart: enabled = " .. tostring(cfg.autoRestart)
				.. (boot.queued and ", loader queued" or ", loader not queued"))
			if not boot.supported then
				log("autorestart: executor без queue_on_teleport — авто-подъём после телепорта невозможен")
			elseif cfg.autoRestart and boot.queued then
				log("autorestart: после телепорта/перезахода бот загрузится сам по URL")
			end
		end,
	})

	pcall(function()
		configTab:CreateParagraph({
			Title = "Авто-перезапуск после перезахода",
			Content = "Реплей данжа = телепорт на новый сервер, где скрипт уничтожается. Бот поднимается сам: queue_on_teleport ставит загрузчик, который после телепорта тянет скрипт по ссылке GitHub (" .. REMOTE_URL .. ") и запускает — autoexec и локальные файлы не нужны. Тумблер выше включает/выключает авто-загрузку (выключение действует с текущего запуска). Обновления скрипта просто коммить в репозиторий. Конфиг (данж, мастер, все настройки) применится автоматически.",
		})
	end)

	pcall(function()
		configTab:CreateParagraph({
			Title = "Сохранение настроек",
			Content = "Конфиг хранится в DungeonBot/config.json (папка executor'а) и автоматически загружается при старте скрипта: выбранный данж, мастер-вкл, стоп-дистанция, каст, способности в слотах, все тумблеры и слайдеры. Каждое изменение сохраняется через секунду автоматически. «Загрузить» применяется к логике сразу, но отображение GUI обновится после перезапуска скрипта.",
		})
	end)

	pcall(function()
		configTab:CreateParagraph({
			Title = "Авто-скрытие меню",
			Content = "Тумблер «Прятать меню при загрузке» делает так, чтобы при экзекуе (и при авто-перезапуске после телепорта) меню Rayfield НЕ появлялось на экране вообще — ни интро, ни самой панели. Действует со следующего запуска скрипта; текущее меню спрячет/покажет клавиша K (встроенный хоткей Rayfield).",
		})
	end)

	log("gui ready")
end)

log("DungeonBot loaded")
