local function getRoot(model)
	if model == nil then
		return nil
	end
	local root = model.PrimaryPart
	if root == nil then
		root = model:FindFirstChild("HumanoidRootPart")
	end
	if root == nil then
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid ~= nil then
			root = humanoid.RootPart
		end
	end
	return root
end

local function validateEnemies()
	local now = os.clock()
	local toRemove = {}
	for model in pairs(bot.enemies) do
		if not model:IsDescendantOf(workspace) then
			table.insert(toRemove, model)
		else
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid == nil or humanoid.Health <= 0 then
				table.insert(toRemove, model)
			end
		end
	end
	for _, model in ipairs(toRemove) do
		bot.enemies[model] = nil
		if bot.target == model then
			bot.target = nil
			bot.nextRetargetAt = now + rand(0.15, 0.4)
			log("target died/removed: " .. model.Name)
		end
	end
end

local function makeLosParams(targetModel)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character ~= nil then
			table.insert(exclude, player.Character)
		end
	end
	for model in pairs(bot.enemies) do
		table.insert(exclude, model)
	end
	if targetModel ~= nil then
		table.insert(exclude, targetModel)
	end
	params.FilterDescendantsInstances = exclude
	params.IgnoreWater = true
	params.RespectCanCollide = true
	return params
end

-- LOS с учётом невидимых барьеров: рейкаст блокируется только реальными
-- коллайдерами (RespectCanCollide, декор пролетает насквозь), плюс второй
-- луч на «уровне колена» ловит низкие препятствия под верхним лучом.
local function hasLOS(from, to, targetModel)
	local params = makeLosParams(targetModel)
	if workspace:Raycast(from, to - from, params) ~= nil then
		return false
	end
	local low = from + Vector3.new(0, -LOS_KNEE_DROP, 0)
	return workspace:Raycast(low, to - low, params) == nil
end

local function targetScore(model, hrp)
	local root = getRoot(model)
	if root == nil then
		return nil
	end
	local score = (root.Position - hrp.Position).Magnitude
	if not hasLOS(hrp.Position, root.Position, model) then
		score += LOS_PENALTY
	end
	return score
end

-- Ближайшая живая цель; мёртвые/без-root модели чистятся из реестра на ходу.
local function pickTarget()
	local hrp = bot.hrp
	if hrp == nil then
		return nil, nil
	end
	local best, bestScore = nil, math.huge
	for model in pairs(bot.enemies) do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local score = nil
		if humanoid ~= nil and humanoid.Health > 0 then
			score = targetScore(model, hrp)
		end
		if score ~= nil then
			if score < bestScore then
				best, bestScore = model, score
			end
		else
			bot.enemies[model] = nil
		end
	end
	return best, bestScore
end

local function getRoute(dungeonName)
	if dungeonName == nil then
		return nil
	end
	local data = DUNGEONS[dungeonName]
	return data ~= nil and data.route or nil
end

-- Живые враги в радиусе radius от позиции (для босс-гейтов Northern Lands).
local function countEnemiesNear(pos, radius)
	local count = 0
	for model in pairs(bot.enemies) do
		local root = getRoot(model)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if root ~= nil and humanoid ~= nil and humanoid.Health > 0 then
			if (root.Position - pos).Magnitude <= radius then
				count += 1
			end
		end
	end
	return count
end

