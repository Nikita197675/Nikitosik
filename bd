local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local CoreGui = (gethui and gethui()) or game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Защита от дубликатов
if getgenv().SideDashUI then
    pcall(getgenv().SideDashUI)
end

local Settings = {
    Enabled = true,
    SideDashDelay = 0.32, -- Стартовое время
    HideKey = Enum.KeyCode.RightControl -- Кнопка скрытия меню (Правый Ctrl)
}

-- ID анимаций боковых рывков
local SIDE_DASH_IDS = {
    ["rbxassetid://10480796021"] = true,
    ["rbxassetid://10480793962"] = true,
}

-- =====================================
-- СОЗДАНИЕ МИНИ-UI
-- =====================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SideDashUI"
ScreenGui.Parent = CoreGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 230, 0, 115)
MainFrame.Position = UDim2.new(0.5, -115, 0.8, -115)
MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
