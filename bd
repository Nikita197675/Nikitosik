local function CreateRow(name, yPos, key)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -110, 0, 25)
    Label.Position = UDim2.new(0, 10, 0, yPos)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = Color3.fromRGB(220, 220, 220)
    Label.Text = name .. ":"
    Label.Font = Enum.Font.SourceSansSemibold
    Label.TextSize = 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = MainFrame

    -- Кнопка минус
    local BtnMinus = Instance.new("TextButton")
    BtnMinus.Size = UDim2.new(0, 22, 0, 22)
    BtnMinus.Position = UDim2.new(1, -95, 0, yPos + 1)
    BtnMinus.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    BtnMinus.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnMinus.Text = "-"
    BtnMinus.Parent = MainFrame
    Instance.new("UICorner", BtnMinus).CornerRadius = UDim.new(0, 4)

    -- Поле для ввода своего значения
    local InputBox = Instance.new("TextBox")
    InputBox.Size = UDim2.new(0, 40, 0, 22)
    InputBox.Position = UDim2.new(1, -70, 0, yPos + 1)
    InputBox.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    InputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    InputBox.Text = string.format("%.3f", Settings[key])
    InputBox.Font = Enum.Font.Code
    InputBox.TextSize = 13
    InputBox.Parent = MainFrame
    Instance.new("UICorner", InputBox).CornerRadius = UDim.new(0, 4)

    -- Кнопка плюс
    local BtnPlus = Instance.new("TextButton")
    BtnPlus.Size = UDim2.new(0, 22, 0, 22)
    BtnPlus.Position = UDim2.new(1, -27, 0, yPos + 1)
    BtnPlus.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    BtnPlus.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnPlus.Text = "+"
    BtnPlus.Parent = MainFrame
    Instance.new("UICorner", BtnPlus).CornerRadius = UDim.new(0, 4)

    local function UpdateText()
        InputBox.Text = string.format("%.3f", Settings[key])
    end

    BtnPlus.MouseButton1Click:Connect(function()
        Settings[key] = math.clamp(Settings[key] + 0.01, 0, 5)
        UpdateText()
    end)

    BtnMinus.MouseButton1Click:Connect(function()
        Settings[key] = math.clamp(Settings[key] - 0.01, 0, 5)
        UpdateText()
    end)

    -- Логика ручного ввода
    InputBox.FocusLost:Connect(function()
        local num = tonumber(InputBox.Text)
        if num then
            Settings[key] = num
        end
        UpdateText()
    end)
end

CreateRow("Cancel Delay", 40, "SideDashDelay")

