CloseBtn.Parent = MainFrame
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 4)

-- =====================================
-- ЛОГИКА ОТМЕНЫ ЭНДЛАГА
-- =====================================
local connections = {}

-- Биндим скрытие меню
table.insert(connections, UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Settings.HideKey then
        MainFrame.Visible = not MainFrame.Visible
    end
end))

local function HookCharacter(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 5)
    if not animator then return end

    table.insert(connections, animator.AnimationPlayed:Connect(function(track)
        if not Settings.Enabled or not track.Animation then return end
        
        local id = track.Animation.AnimationId
        
        if SIDE_DASH_IDS[id] then
            task.delay(Settings.SideDashDelay, function()
                if not Settings.Enabled or not char.Parent then return end
                
                -- Обнуляем все кулдауны
                char:SetAttribute("_LastDash", 0)
                char:SetAttribute("JustLeftDashed", 0)
                char:SetAttribute("JustRightDashed", 0)
                char:SetAttribute("_JustDashed", 0)
                
                -- Переименовываем визуальный маркер
                local usedDash = char:FindFirstChild("UsedDash")
                if usedDash then 
                    usedDash.Name = "GhostMarker" 
                end
                
                -- Переименовываем физику
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local vel = root:FindFirstChild("dodgevelocity")
                    if vel then 
                        vel.Name = "GhostVelocity" 
                    end
                end
            end)
        end
    end))
end

if LocalPlayer.Character then
    HookCharacter(LocalPlayer.Character)
end
table.insert(connections, LocalPlayer.CharacterAdded:Connect(HookCharacter))

-- =====================================
-- АНЛОАД
-- =====================================
getgenv().SideDashUI = function()
    Settings.Enabled = false
    for _, c in ipairs(connections) do
        if c.Connected then c:Disconnect() end
    end
    table.clear(connections)
    if ScreenGui then ScreenGui:Destroy() end
    getgenv().SideDashUI = nil
end

CloseBtn.MouseButton1Click:Connect(getgenv().SideDashUI)
