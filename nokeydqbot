end)

local function setupCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	bot.hrp = hrp
	if humanoid == nil or hrp == nil then
		return
	end
	humanoid.Died:Connect(function()
		bot.state = "DEAD"
		bot.target = nil
		bot.waitUntil = nil
		resetPathState()
		log("died")
	end)
	if cfg.speedBoost and cfg.enabled then
		humanoid.WalkSpeed = SPEED_BOOST
	end
	humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if cfg.speedBoost and cfg.enabled and humanoid.Parent ~= nil
			and humanoid.Health > 0 and humanoid.WalkSpeed ~= SPEED_BOOST then
			-- Мгновенный возврат: скорость выше буста (рывок способности) не
			-- трогаем — только меньше. Периодический тик докроет остальное.
			if humanoid.WalkSpeed < SPEED_BOOST then
				humanoid.WalkSpeed = SPEED_BOOST
			else
				task.delay(rand(0.1, 0.3), function()
					if cfg.speedBoost and cfg.enabled and humanoid.Parent ~= nil
						and humanoid.WalkSpeed ~= SPEED_BOOST then
						humanoid.WalkSpeed = SPEED_BOOST
					end
				end)
			end
		end
	end)
	bot.state = "IDLE"
	log("character ready")
	if cfg.enabled and not bot.started then
		bot.started = true
		task.delay(0.5, function()
			if cfg.enabled then
				setEnabled(true)
			end
		end)
	end
end

