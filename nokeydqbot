local logLines = {}

local function log(text)
	table.insert(logLines, ("[%s] %s"):format(os.date("%H:%M:%S"), tostring(text)))
	while #logLines > LOG_LINES do
		table.remove(logLines, 1)
	end
	if logLabel then
		logLabel.Text = table.concat(logLines, "\n")
	end
end

-- == Сохранение конфига (файл DungeonBot/config.json в папке executor'а) ==

local CONFIG_FILE = "DungeonBot/config.json"
local CONFIG_VERSION = 2

local function saveConfig()
	if writefile == nil then
		log("config save: writefile unavailable in this executor")
		return false
	end
	pcall(function()
		makefolder("DungeonBot")
	end)
	local data = {}
	for key, value in pairs(cfg) do
		if type(value) == "boolean" or type(value) == "number" then
			data[key] = value
		end
	end
	data.configVersion = CONFIG_VERSION
	if bot.currentDungeon ~= nil then
		data.dungeon = bot.currentDungeon
	end
	if SKILLS ~= nil then
		local skills = {}
		for i, skill in ipairs(SKILLS) do
			table.insert(skills, { name = skill.name, cd = skill.cd })
		end
		data.skills = skills
	end
	local ok = pcall(function()
		writefile(CONFIG_FILE, game:GetService("HttpService"):JSONEncode(data))
	end)
	if ok then
		log("config saved: " .. CONFIG_FILE)
	else
		log("config save: failed")
	end
	return ok
end

local saveQueued = false
local function scheduleSave()
	if not cfg.autoSave then
		return
	end
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(1, function()
		saveQueued = false
		saveConfig()
	end)
end

local function applyConfigData(data)
	if type(data) ~= "table" then
		return 0
	end
	local applied = 0
	local oldConfig = data.configVersion ~= CONFIG_VERSION
	for key, value in pairs(data) do
		if key ~= "dungeon" and key ~= "configVersion" and cfg[key] ~= nil and type(cfg[key]) == type(value) then
			-- Старый конфиг (без версии): castRange не восстанавливаем — пусть
			-- применится новый дефолт (90); остальное восстанавливаем как есть.
			if not (oldConfig and key == "castRange") then
				cfg[key] = value
				applied += 1
			end
		end
	end
	local dungeon = data.dungeon
	if type(dungeon) == "string" and DUNGEONS[dungeon] ~= nil then
		bot.currentDungeon = dungeon
		bot.routeIndex = 1
		bot.routeDone = false
		bot.routeLastWp = nil
		bot.routeLastDist = nil
		applied += 1
		log("config: dungeon -> " .. dungeon)
	end
	if type(data.skills) == "table" then
		for _, saved in ipairs(data.skills) do
			if type(saved) == "table" and type(saved.name) == "string" then
				for _, skill in ipairs(SKILLS) do
					if skill.name == saved.name and type(saved.cd) == "number" then
						skill.cd = saved.cd
						applied += 1
						break
					end
				end
			end
		end
	end
	return applied
end

local function loadConfig()
	if isfile == nil or readfile == nil then
		log("config load: file api unavailable")
		return false
	end
	local ok, result = pcall(function()
		return game:GetService("HttpService"):JSONDecode(readfile(CONFIG_FILE))
	end)
	if not ok or type(result) ~= "table" then
		return false
	end
	local applied = applyConfigData(result)
	log(("config loaded: %d settings applied"):format(applied))
	return true
end

