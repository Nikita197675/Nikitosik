local function getCharParts()
	local character = LocalPlayer.Character
	if character == nil then
		return nil, nil
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return hrp, humanoid
end

local function isEnemyModel(model)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return false
	end
	if Players:GetPlayerFromCharacter(model) ~= nil then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return false
	end
	for _, sig in ipairs(ENEMY_SIGS) do
		if model:FindFirstChild(sig, true) ~= nil then
			return true
		end
	end
	return false
end

local function tryRegister(inst)
	if isEnemyModel(inst) then
		if not bot.enemies[inst] then
			bot.enemies[inst] = true
		end
	end
end

local function scanContainer(container, depth)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Model") then
			tryRegister(child)
		end
		if depth < 4 and (child:IsA("Folder") or child:IsA("Model")) then
			scanContainer(child, depth + 1)
		end
	end
end

